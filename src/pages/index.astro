---
import Base from "../layouts/Base.astro";
import AnnouncementBar from "../components/AnnouncementBar.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Collections from "../components/Collections.astro";
import Story from "../components/Story.astro";
import Trust from "../components/Trust.astro";
import Skirts from "../components/Skirts.astro";
import Testimonials from "../components/Testimonials.astro";
import Instagram from "../components/Instagram.astro";
import Footer from "../components/Footer.astro";
import CartDrawer from "../components/CartDrawer.astro";
import FloatingCart from "../components/FloatingCart.astro";
---
<Base title="Maison Sabra | Sacs artisanaux marocains" description="Sacs et pochettes artisanaux en velours, cuir et tissu berbère, inspirés du patrimoine marocain.">
  <AnnouncementBar />
  <Header />
  <main id="contenu">
    <Hero />
    <Collections />
    <Story />
    <Trust />
    <Skirts />
    <Testimonials />
    <Instagram />
  </main>
  <Footer />
  <FloatingCart />
  <CartDrawer />
</Base>
