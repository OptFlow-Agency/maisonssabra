---
import Admin from "../../layouts/Admin.astro";
import AdminShell from "../../components/AdminShell.astro";

const filters = [
  ["", "Toutes"], ["new", "Nouvelles"], ["confirmed", "Confirmées"], ["shipped", "Expédiées"], ["delivered", "Livrées"], ["cancelled", "Annulées"],
] as const;
---
<Admin title="Commandes">
  <AdminShell current="commandes">
    <main class="mx-auto max-w-5xl px-(--gutter) py-10 min-[48rem]:py-14">
      <div class="mb-6 grid gap-1">
        <h1 class="text-step-2">Commandes</h1>
        <p class="m-0 text-sm text-ink-soft" data-count aria-live="polite">Chargement…</p>
      </div>

      <form class="mb-8 flex flex-wrap items-end gap-3" role="search" aria-label="Filtrer les commandes" data-toolbar onsubmit="return false">
        <div class="grid min-w-56 flex-1 gap-1.5">
          <label class="field-label" for="orders-search">Recherche</label>
          <input class="field min-h-11 py-0" id="orders-search" type="search" placeholder="Nom, téléphone ou n° (MS-…)" autocomplete="off" data-search />
        </div>
        <div class="flex flex-wrap items-end gap-3">
          <div class="grid gap-1.5">
            <label class="field-label" for="orders-status">Statut</label>
            <select class="field min-h-11 w-auto min-w-40 py-0" id="orders-status" data-status>
              {filters.map(([value, label]) => <option value={value}>{label}</option>)}
            </select>
          </div>
          <div class="relative grid gap-1.5" data-range>
            <span class="field-label" id="orders-range-label">Période</span>
            <button class="field flex min-h-11 w-auto min-w-64 cursor-pointer items-center gap-3 py-0 text-left" type="button" id="orders-range" aria-haspopup="dialog" aria-expanded="false" aria-labelledby="orders-range-label orders-range" data-range-trigger>
              <svg class="size-4 shrink-0 text-burgundy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="16"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
              <span data-range-text class="mr-auto text-ink-soft">Toutes les dates</span>
            </button>
            <div class="fixed z-30 hidden w-[min(20rem,calc(100vw-2*var(--gutter)))] border border-gold/55 bg-white p-4 shadow-lg min-[40rem]:w-[39rem]" role="dialog" aria-label="Choisir une période" data-range-pop>
              <button class="absolute top-4 left-4 grid size-9 cursor-pointer place-items-center border-0 bg-transparent text-burgundy hover:bg-rose/15" type="button" data-prev aria-label="Mois précédent">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 5-7 7 7 7"/></svg>
              </button>
              <button class="absolute top-4 right-4 grid size-9 cursor-pointer place-items-center border-0 bg-transparent text-burgundy hover:bg-rose/15" type="button" data-next aria-label="Mois suivant">
                <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg>
              </button>
              <div class="grid gap-8 min-[40rem]:grid-cols-2" data-months aria-live="polite"></div>
              <div class="mt-4 flex items-center justify-between gap-3 border-t border-gold/55 pt-3 text-sm">
                <div class="flex gap-4">
                  <button class="cursor-pointer border-0 bg-transparent p-0 font-semibold text-burgundy underline underline-offset-4" type="button" data-clear>Effacer</button>
                  <button class="cursor-pointer border-0 bg-transparent p-0 font-semibold text-burgundy underline underline-offset-4" type="button" data-today>Aujourd’hui</button>
                </div>
                <button class="btn-ghost min-h-10 disabled:cursor-not-allowed disabled:opacity-50" type="button" data-apply>Appliquer</button>
              </div>
            </div>
          </div>
          <button class="min-h-11 cursor-pointer border-0 bg-transparent px-4 text-sm font-semibold tracking-[0.06em] text-burgundy uppercase ring-1 ring-burgundy/35 transition-colors duration-200 ring-inset hover:bg-rose/15" type="button" data-sort aria-label="Trier par date : plus récentes d’abord">Date ↓</button>
        </div>
      </form>

      <p class="m-0 mb-6 hidden border border-burgundy-deep bg-white p-4 text-burgundy-deep" role="alert" data-list-error></p>

      <ul class="m-0 grid list-none gap-6 p-0" data-orders></ul>

      <div class="mt-8 hidden justify-center" data-more-wrap>
        <button class="btn-ghost min-h-13" type="button" data-more>Afficher plus de commandes</button>
      </div>

      <div class="hidden max-w-md gap-3 border border-gold/55 bg-white p-8" data-empty>
        <p class="m-0 font-display text-step-1 text-burgundy" data-empty-title>Aucune commande pour le moment</p>
        <p class="m-0 text-ink-soft" data-empty-text>Les commandes passées sur la boutique apparaîtront ici, avec les coordonnées de la cliente et les produits demandés.</p>
      </div>
    </main>
  </AdminShell>
</Admin>

<script>
  import { guard } from "../../scripts/admin/auth";
  import { supabase, fmt, toast, type OrderRow, type OrderStatus } from "../../scripts/admin/supabase";

  const PAGE = 20;
  const STATUS: Record<OrderStatus, { label: string; badge: string }> = {
    new: { label: "Nouvelle", badge: "bg-rose text-burgundy-deep" },
    confirmed: { label: "Confirmée", badge: "bg-teal text-white" },
    shipped: { label: "Expédiée", badge: "bg-burgundy text-cream" },
    delivered: { label: "Livrée", badge: "bg-burgundy-deep text-cream" },
    cancelled: { label: "Annulée", badge: "text-ink-soft ring-1 ring-ink-soft/50 ring-inset" },
  };

  const list = document.querySelector<HTMLElement>("[data-orders]")!;
  const count = document.querySelector<HTMLElement>("[data-count]")!;
  const err = document.querySelector<HTMLElement>("[data-list-error]")!;
  const empty = document.querySelector<HTMLElement>("[data-empty]")!;
  const moreWrap = document.querySelector<HTMLElement>("[data-more-wrap]")!;
  const moreBtn = document.querySelector<HTMLButtonElement>("[data-more]")!;
  const searchIn = document.querySelector<HTMLInputElement>("[data-search]")!;
  const statusSel = document.querySelector<HTMLSelectElement>("[data-status]")!;
  const range = document.querySelector<HTMLElement>("[data-range]")!;
  const rangeBtn = range.querySelector<HTMLButtonElement>("[data-range-trigger]")!;
  const rangeText = range.querySelector<HTMLElement>("[data-range-text]")!;
  const pop = range.querySelector<HTMLElement>("[data-range-pop]")!;
  const months = range.querySelector<HTMLElement>("[data-months]")!;
  // Selected range as local YYYY-MM-DD strings ("" = open-ended).
  const sel = { from: "", to: "" };
  // Pending selection inside the open popover; committed to `sel` by "Appliquer".
  const draft = { from: "", to: "" };
  const applyBtn = range.querySelector<HTMLButtonElement>("[data-apply]")!;
  const sortBtn = document.querySelector<HTMLButtonElement>("[data-sort]")!;

  let status = "";
  let ascending = false;
  let loaded = 0;
  let total = 0;

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = "", text = "") => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text) e.textContent = text;
    return e;
  };

  // Images are snapshotted with an absolute maisonsabra.ma URL; bundled site images are served by this same host.
  const imgSrc = (u: string) => { try { const x = new URL(u); return x.hostname === "maisonsabra.ma" ? x.pathname : u; } catch { return u; } };
  const whatsapp = (phone: string) => {
    const d = phone.replace(/[\s.\-()+]/g, "");
    const m = d.match(/^(?:212|0)([5-7]\d{8})$/);
    return m ? `https://wa.me/212${m[1]}` : "";
  };

  function card(o: OrderRow) {
    const li = el("li", "grid gap-0 border border-gold/55 bg-white");

    const head = el("div", "flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-b border-gold/55 px-5 py-4");
    const title = el("div", "grid gap-0.5");
    title.append(
      el("h2", "m-0 font-display text-step-1 leading-none text-burgundy lining-nums", `MS-${o.order_number}`),
      el("p", "m-0 text-sm text-ink-soft", new Date(o.created_at).toLocaleString("fr-FR", { dateStyle: "medium", timeStyle: "short" })),
    );
    const badge = el("span", `inline-block px-2.5 py-1.5 text-[0.6875rem] leading-none font-semibold tracking-[0.08em] uppercase ${STATUS[o.status].badge}`, STATUS[o.status].label);
    head.append(title, badge);

    const body = el("div", "grid gap-6 px-5 py-5 min-[48rem]:grid-cols-[minmax(0,1fr)_minmax(0,1.4fr)] min-[48rem]:gap-10");

    // Customer
    const who = el("div", "grid content-start gap-1.5");
    who.append(el("p", "m-0 text-xs font-semibold tracking-[0.08em] text-ink-soft uppercase", "Cliente"), el("p", "m-0 font-semibold", `${o.first_name} ${o.last_name}`));
    const tel = el("a", "w-fit text-burgundy underline underline-offset-4 hover:text-rose-dusty tabular-nums", o.phone);
    tel.href = `tel:${o.phone.replace(/[\s.\-()]/g, "")}`;
    const contact = el("p", "m-0 flex flex-wrap items-center gap-x-4 gap-y-1");
    contact.append(tel);
    const wa = whatsapp(o.phone);
    if (wa) { const a = el("a", "text-sm text-ink-soft underline underline-offset-4 hover:text-burgundy", "WhatsApp"); a.href = wa; a.target = "_blank"; a.rel = "noopener"; contact.append(a); }
    who.append(contact, el("p", "m-0 text-ink-soft", o.address), el("p", "m-0 text-ink-soft", o.city));

    // Products
    const what = el("div", "grid content-start gap-3");
    what.append(el("p", "m-0 text-xs font-semibold tracking-[0.08em] text-ink-soft uppercase", `Produits demandés (${o.order_items.reduce((n, i) => n + i.quantity, 0)})`));
    const items = el("ul", "m-0 grid list-none gap-3 p-0");
    for (const it of o.order_items) {
      const row = el("li", "grid grid-cols-[3.5rem_minmax(0,1fr)_auto] items-center gap-3");
      const img = el("img", "size-14 bg-cream-soft object-cover");
      img.src = imgSrc(it.product_image); img.alt = ""; img.width = 56; img.height = 56; img.loading = "lazy";
      const txt = el("div", "grid min-w-0 gap-0.5");
      txt.append(el("p", "m-0 text-sm font-semibold leading-snug", it.product_name), el("p", "m-0 text-sm text-ink-soft tabular-nums", `${it.quantity} × ${fmt(it.unit_price)}`));
      row.append(img, txt, el("p", "m-0 text-sm font-semibold tabular-nums", fmt(it.line_total)));
      items.append(row);
    }
    what.append(items);
    body.append(who, what);

    // Footer: status + totals
    const foot = el("div", "flex flex-wrap items-end justify-between gap-x-6 gap-y-4 border-t border-gold/55 bg-cream-soft px-5 py-4");
    const sel = el("div", "grid gap-1.5");
    const id = `status-${o.id}`;
    const lab = el("label", "field-label", "Statut");
    lab.htmlFor = id;
    const select = el("select", "field min-h-11 w-auto min-w-44 py-0");
    select.id = id;
    for (const [v, s] of Object.entries(STATUS)) { const op = el("option", "", s.label); op.value = v; select.append(op); }
    select.value = o.status;
    select.addEventListener("change", async () => {
      const next = select.value as OrderStatus, prev = o.status;
      select.disabled = true;
      const { error } = await supabase.from("orders").update({ status: next }).eq("id", o.id);
      select.disabled = false;
      if (error) { select.value = prev; toast("Impossible de changer le statut. Réessayez.", "error"); return; }
      o.status = next;
      badge.textContent = STATUS[next].label;
      badge.className = `inline-block px-2.5 py-1.5 text-[0.6875rem] leading-none font-semibold tracking-[0.08em] uppercase ${STATUS[next].badge}`;
      toast(`Commande MS-${o.order_number} : ${STATUS[next].label.toLowerCase()}.`);
    });
    sel.append(lab, select);

    const sums = el("div", "grid gap-1 text-right text-sm tabular-nums");
    if (o.discount > 0) {
      sums.append(
        el("p", "m-0 text-ink-soft", `Sous-total ${fmt(o.subtotal ?? o.total + o.discount)}`),
        el("p", "m-0 text-ink-soft", `Code ${o.promo_code ?? ""} : −${fmt(o.discount)}`),
      );
    }
    const tot = el("p", "m-0 flex items-baseline justify-end gap-3");
    tot.append(el("span", "text-xs font-semibold tracking-[0.08em] uppercase", "Total"), el("span", "text-step-1 font-semibold text-burgundy", fmt(o.total)));
    sums.append(tot);
    foot.append(sel, sums);

    li.append(head, body, foot);
    return li;
  }

  async function load(more = false) {
    err.classList.add("hidden");
    moreBtn.disabled = true;
    if (!more) { loaded = 0; list.replaceChildren(); }
    let q = supabase.from("orders").select("*, order_items(*)", { count: "exact" }).order("created_at", { ascending }).range(loaded, loaded + PAGE - 1);
    if (status) q = q.eq("status", status);
    // Strip characters that would break the PostgREST or() grammar or act as ilike wildcards.
    const term = searchIn.value.trim().replace(/[,()%*_\\]/g, " ").trim();
    if (term) {
      const parts = [`first_name.ilike.%${term}%`, `last_name.ilike.%${term}%`, `phone.ilike.%${term}%`];
      const num = term.replace(/^ms-?/i, "");
      if (/^\d+$/.test(num)) parts.push(`order_number.eq.${num}`);
      q = q.or(parts.join(","));
    }
    if (sel.from) q = q.gte("created_at", new Date(`${sel.from}T00:00:00`).toISOString());
    if (sel.to) { const end = new Date(`${sel.to}T00:00:00`); end.setDate(end.getDate() + 1); q = q.lt("created_at", end.toISOString()); }
    const { data, error, count: n } = await q;
    moreBtn.disabled = false;
    if (error) {
      err.textContent = error.code === "42703" || error.code === "42P01"
        ? "La base n’est pas à jour : exécutez la migration 20261023020000_promo_codes.sql."
        : "Impossible de charger les commandes. Vérifiez votre connexion puis rechargez la page.";
      err.classList.remove("hidden"); count.textContent = ""; return;
    }
    const rows = (data ?? []) as OrderRow[];
    total = n ?? rows.length;
    loaded += rows.length;
    list.append(...rows.map(card));

    count.textContent = total === 0 ? "" : `${total} commande${total > 1 ? "s" : ""}${status ? ` ${STATUS[status as OrderStatus].label.toLowerCase()}${total > 1 ? "s" : ""}` : ""}`;
    const filtered = !!(status || term || sel.from || sel.to);
    const none = total === 0;
    empty.classList.toggle("hidden", !none);
    empty.classList.toggle("grid", none);
    if (none) {
      empty.querySelector("[data-empty-title]")!.textContent = filtered ? "Aucune commande trouvée" : "Aucune commande pour le moment";
      empty.querySelector("[data-empty-text]")!.textContent = filtered ? "Modifiez la recherche ou les filtres pour voir d’autres commandes." : "Les commandes passées sur la boutique apparaîtront ici, avec les coordonnées de la cliente et les produits demandés.";
      count.textContent = "";
    }
    moreWrap.classList.toggle("hidden", loaded >= total);
    moreWrap.classList.toggle("flex", loaded < total);
  }

  let timer: ReturnType<typeof setTimeout>;
  searchIn.addEventListener("input", () => { clearTimeout(timer); timer = setTimeout(() => load(), 300); });
  statusSel.addEventListener("change", () => { status = statusSel.value; load(); });
  const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
  const short = (v: string) => new Date(`${v}T00:00:00`).toLocaleDateString("fr-FR", { day: "numeric", month: "short", year: "numeric" });
  let view = new Date(); view.setDate(1);
  let picking = false; // true once a start date is chosen and we await the end

  function renderRange() {
    rangeText.textContent = !sel.from ? "Toutes les dates" : sel.to && sel.to !== sel.from ? `${short(sel.from)} – ${short(sel.to)}` : short(sel.from);
    rangeText.classList.toggle("text-ink-soft", !sel.from);
  }

  function renderMonth() {
    months.replaceChildren();
    const today = iso(new Date());
    for (let m = 0; m < 2; m++) {
      const first = new Date(view.getFullYear(), view.getMonth() + m, 1);
      const block = el("div", m ? "max-[40rem]:hidden" : "");
      block.append(el("p", "m-0 mb-3 flex h-9 items-center justify-center font-display text-base text-burgundy capitalize", first.toLocaleDateString("fr-FR", { month: "long", year: "numeric" })));
      const head = el("div", "grid grid-cols-7 text-center text-xs font-semibold tracking-[0.06em] text-ink-soft uppercase");
      head.setAttribute("aria-hidden", "true");
      for (const d of ["L", "M", "M", "J", "V", "S", "D"]) head.append(el("span", "py-1", d));
      const grid = el("div", "grid grid-cols-7");
      grid.dataset.days = "";
      const lead = (first.getDay() + 6) % 7;
      for (let i = 0; i < lead; i++) grid.append(el("span"));
      const len = new Date(first.getFullYear(), first.getMonth() + 1, 0).getDate();
      for (let n = 1; n <= len; n++) {
        const d = new Date(first.getFullYear(), first.getMonth(), n);
        const v = iso(d);
        const edge = v === draft.from || v === draft.to;
        const inside = draft.from && draft.to && v > draft.from && v < draft.to;
        const b = el("button", `h-10 cursor-pointer border-0 text-sm tabular-nums transition-colors ${edge ? "bg-burgundy font-semibold text-cream" : inside ? "bg-rose/25 text-burgundy-deep" : "bg-transparent text-ink hover:bg-rose/15"} ${v === today && !edge ? "ring-1 ring-gold ring-inset" : ""}`, String(n));
        b.type = "button"; b.dataset.date = v;
        b.setAttribute("aria-label", d.toLocaleDateString("fr-FR", { dateStyle: "full" }));
        if (edge) b.setAttribute("aria-pressed", "true");
        grid.append(b);
      }
      block.append(head, grid);
      months.append(block);
    }
  }

  // Fixed + clamped to the viewport so the two-month panel never overflows the page.
  function place() {
    if (pop.classList.contains("hidden")) return;
    const r = rangeBtn.getBoundingClientRect();
    const w = pop.offsetWidth;
    pop.style.left = `${Math.max(8, Math.min(r.left, window.innerWidth - w - 8))}px`;
    pop.style.top = `${r.bottom + 4}px`;
  }

  function setOpen(open: boolean) {
    pop.classList.toggle("hidden", !open);
    rangeBtn.setAttribute("aria-expanded", String(open));
    if (open) {
      draft.from = sel.from; draft.to = sel.to;
      if (sel.from) { view = new Date(`${sel.from}T00:00:00`); view.setDate(1); }
      picking = false; applyBtn.disabled = !draft.from; renderMonth(); place();
    }
  }
  window.addEventListener("resize", place);
  window.addEventListener("scroll", place, { passive: true });

  const apply = () => { renderRange(); load(); };
  rangeBtn.addEventListener("click", () => setOpen(pop.classList.contains("hidden")));
  // composedPath: a day click re-renders the grid, so the target is detached by the time this runs.
  document.addEventListener("click", (e) => { if (!e.composedPath().includes(range)) setOpen(false); });
  range.addEventListener("keydown", (e) => { if (e.key === "Escape") { setOpen(false); rangeBtn.focus(); } });
  range.querySelector("[data-prev]")!.addEventListener("click", () => { view = new Date(view.getFullYear(), view.getMonth() - 1, 1); renderMonth(); });
  range.querySelector("[data-next]")!.addEventListener("click", () => { view = new Date(view.getFullYear(), view.getMonth() + 1, 1); renderMonth(); });
  range.querySelector("[data-clear]")!.addEventListener("click", () => { sel.from = sel.to = ""; apply(); setOpen(false); });
  range.querySelector("[data-today]")!.addEventListener("click", () => { draft.from = draft.to = iso(new Date()); picking = false; applyBtn.disabled = false; renderMonth(); });
  applyBtn.addEventListener("click", () => { sel.from = draft.from; sel.to = draft.to; apply(); setOpen(false); });
  months.addEventListener("click", (e) => {
    const v = (e.target as HTMLElement).closest<HTMLElement>("[data-date]")?.dataset.date;
    if (!v) return;
    if (!picking) { draft.from = draft.to = v; picking = true; }
    else { if (v < draft.from) { draft.to = draft.from; draft.from = v; } else draft.to = v; picking = false; }
    applyBtn.disabled = false;
    renderMonth();
  });
  sortBtn.addEventListener("click", () => {
    ascending = !ascending;
    sortBtn.textContent = ascending ? "Date ↑" : "Date ↓";
    sortBtn.setAttribute("aria-label", `Trier par date : ${ascending ? "plus anciennes" : "plus récentes"} d’abord`);
    load();
  });
  moreBtn.addEventListener("click", () => load(true));

  // Arriving from an email link (?client=…): prefill the search so the list is already filtered.
  const clientParam = new URLSearchParams(location.search).get("client");
  if (clientParam) searchIn.value = clientParam.trim();

  guard(() => load());
</script>
