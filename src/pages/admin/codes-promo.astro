---
import Admin from "../../layouts/Admin.astro";
import AdminShell from "../../components/AdminShell.astro";
import PromoSheet from "../../components/PromoSheet.astro";
---
<Admin title="Codes promo">
  <AdminShell current="codes-promo">
    <main class="mx-auto max-w-5xl px-(--gutter) py-10 min-[48rem]:py-14">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div class="grid gap-1">
          <h1 class="text-step-2">Codes promo</h1>
          <p class="m-0 text-sm text-ink-soft" data-count aria-live="polite">Chargement…</p>
        </div>
        <button class="btn" type="button" data-add-promo>Créer un code</button>
      </div>

      <p class="m-0 hidden border border-burgundy-deep bg-white p-4 text-burgundy-deep" role="alert" data-list-error></p>

      <div class="hidden border border-gold/55 bg-white" data-table>
        <div class="hidden grid-cols-[minmax(0,1fr)_5rem_minmax(0,1.6fr)_7.5rem_5rem] items-center gap-4 border-b border-gold/55 px-4 py-3 text-xs font-semibold tracking-[0.08em] text-ink-soft uppercase min-[48rem]:grid" aria-hidden="true">
          <span>Code</span><span>Remise</span><span>Produits</span><span>Statut</span><span></span>
        </div>
        <ul class="m-0 list-none divide-y divide-burgundy/15 p-0" data-rows></ul>
      </div>

      <div class="hidden max-w-md gap-4 border border-gold/55 bg-white p-8" data-empty>
        <p class="m-0 font-display text-step-1 text-burgundy">Aucun code promo</p>
        <p class="m-0 text-ink-soft">Créez un code, choisissez les produits concernés, puis activez-le. Vos clientes le saisissent au moment de commander.</p>
        <button class="btn justify-self-start" type="button" data-add-promo>Créer un code</button>
      </div>
    </main>
    <PromoSheet />
  </AdminShell>
</Admin>

<script>
  import { guard } from "../../scripts/admin/auth";
  import { supabase, toast, type ProductLite, type PromoRow } from "../../scripts/admin/supabase";
  import { openPromoSheet } from "../../scripts/admin/promo-sheet";

  let products: ProductLite[] = [];

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls = "", text = "") => {
    const e = document.createElement(tag);
    if (cls) e.className = cls;
    if (text) e.textContent = text;
    return e;
  };

  const afterChange = async (what: "saved" | "deleted") => { await load(); toast(what === "deleted" ? "Code supprimé." : "Code enregistré."); };

  function productsLabel(p: PromoRow) {
    const names = p.promo_code_products.map((x) => products.find((q) => q.slug === x.product_slug)?.name ?? x.product_slug);
    if (names.length === 0) return "Aucun produit";
    return names.length === 1 ? names[0] : `${names[0]} et ${names.length - 1} autre${names.length > 2 ? "s" : ""}`;
  }

  function toggle(p: PromoRow) {
    const b = el("button", "relative h-7 w-12 shrink-0 cursor-pointer rounded-full border-0 p-0 transition-colors duration-200 before:absolute before:-inset-2 before:content-[''] after:absolute after:top-1 after:left-1 after:size-5 after:rounded-full after:bg-white after:transition-transform after:duration-200 aria-checked:after:translate-x-5");
    b.type = "button";
    b.setAttribute("role", "switch");
    b.setAttribute("aria-label", `Code ${p.code} actif`);
    const paint = () => { b.setAttribute("aria-checked", String(p.active)); b.classList.toggle("bg-teal", p.active); b.classList.toggle("bg-ink-soft/55", !p.active); };
    paint();
    b.addEventListener("click", async () => {
      const next = !p.active;
      p.active = next; paint(); b.disabled = true;
      const { error } = await supabase.from("promo_codes").update({ active: next }).eq("code", p.code);
      b.disabled = false;
      if (error) { p.active = !next; paint(); toast("Impossible de modifier le code. Réessayez.", "error"); return; }
      label.textContent = next ? "Actif" : "Inactif";
    });
    const label = el("span", "text-sm text-ink-soft", p.active ? "Actif" : "Inactif");
    const wrap = el("div", "flex items-center gap-3");
    wrap.append(b, label);
    return wrap;
  }

  async function load() {
    const [promos, prods] = await Promise.all([
      supabase.from("promo_codes").select("*, promo_code_products(product_slug)").order("created_at", { ascending: false }),
      supabase.from("products").select("slug,name,image,active").order("sort_order").order("created_at", { ascending: false }),
    ]);
    const count = document.querySelector<HTMLElement>("[data-count]")!;
    const table = document.querySelector<HTMLElement>("[data-table]")!;
    const empty = document.querySelector<HTMLElement>("[data-empty]")!;
    const err = document.querySelector<HTMLElement>("[data-list-error]")!;
    if (promos.error || prods.error) {
      err.textContent = promos.error?.code === "42P01" ? "La table des codes promo n’existe pas encore : exécutez la migration 20261023020000_promo_codes.sql." : "Impossible de charger les codes promo. Vérifiez votre connexion puis rechargez la page.";
      err.classList.remove("hidden"); count.textContent = ""; return;
    }
    err.classList.add("hidden");
    products = (prods.data ?? []) as ProductLite[];
    const rows = (promos.data ?? []) as PromoRow[];
    const live = rows.filter((r) => r.active).length;
    count.textContent = `${rows.length} code${rows.length > 1 ? "s" : ""}, ${live} actif${live > 1 ? "s" : ""}`;
    table.classList.toggle("hidden", rows.length === 0);
    empty.classList.toggle("hidden", rows.length > 0);
    empty.classList.toggle("grid", rows.length === 0);

    document.querySelector("[data-rows]")!.replaceChildren(...rows.map((p) => {
      const li = el("li", "grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-3 px-4 py-4 min-[48rem]:grid-cols-[minmax(0,1fr)_5rem_minmax(0,1.6fr)_7.5rem_5rem]");
      const code = el("p", "m-0 font-semibold tracking-[0.08em] text-ink", p.code);
      const pct = el("p", "m-0 text-sm font-semibold tabular-nums", `−${p.percent} %`);
      const prod = el("p", "m-0 col-span-2 truncate text-sm text-ink-soft min-[48rem]:col-span-1", productsLabel(p));
      const sw = toggle(p);
      const edit = el("button", "btn-ghost justify-self-end", "Modifier");
      edit.type = "button";
      edit.setAttribute("aria-label", `Modifier le code ${p.code}`);
      edit.addEventListener("click", () => openPromoSheet(p, products, afterChange));
      li.append(code, pct, prod, sw, edit);
      return li;
    }));
  }

  document.querySelectorAll("[data-add-promo]").forEach((b) => b.addEventListener("click", () => openPromoSheet(null, products, afterChange)));
  guard(load);
</script>
