---
import Page from "../../layouts/Page.astro";
import ZmanPage from "../../zman-lp/components/ZmanPage.astro";
import { products as zmanModels } from "../../zman-lp/data/products.js";
import ProductView from "../../components/ProductView.astro";
import NotFoundView from "../../components/NotFoundView.astro";
import { getCatalog, cacheShort } from "../../lib/catalog";

export const prerender = false;

const products = await getCatalog();
const p = products.find((x) => x.slug === Astro.params.slug);
const model = p?.collection === "zman" && !p.variants?.length && p.purchasable !== false ? zmanModels.find(m => m.slug === p.slug) : undefined;
if (p) cacheShort(Astro.response);
else Astro.response.status = 404;
---
{model ? <ZmanPage modelId={model.id} catalog={products} /> : p ? <ProductView p={p} products={products} /> : <Page title="Page introuvable | Maison Sabra" description="Cette page n’existe pas ou a été déplacée." noindex><NotFoundView /></Page>}
