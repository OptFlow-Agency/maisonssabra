---
import "../styles/global.css";
import sansUrl from "@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url";
import cormorantUrl from "@fontsource/cormorant-garamond/files/cormorant-garamond-latin-500-normal.woff2?url";
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Maison Sabra, administration</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#4a0f22" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={cormorantUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
  </head>
  <body class="min-h-dvh bg-cream-soft">
    <slot />
    <div class="pointer-events-none fixed inset-x-0 bottom-[max(1rem,env(safe-area-inset-bottom))] z-50 grid justify-items-center px-4" aria-live="polite" data-toast-host></div>
  </body>
</html>
