---
const ic = { fill: "none", stroke: "currentColor", "stroke-width": "1.4", "stroke-linecap": "round", "stroke-linejoin": "round", width: 36, height: 36, viewBox: "0 0 36 36", "aria-hidden": "true" } as const;
---
<section class="border-y border-gold/50 bg-cream-soft py-14" aria-label="Nos engagements">
  <ul class="m-0 mx-auto grid max-w-(--max) list-none grid-cols-1 gap-x-8 gap-y-10 p-0 px-(--gutter) min-[48rem]:grid-cols-2 min-[75rem]:grid-cols-4">
    <li class="flex items-start gap-4 text-burgundy" data-reveal>
      <svg {...ic}><path d="M3 9h18v15H3zM21 14h6l5 5v5H21z"/><circle cx="9" cy="26" r="2.5"/><circle cx="26" cy="26" r="2.5"/></svg>
      <div><h3 class="font-body text-base leading-snug font-semibold tracking-normal text-ink">Livraison gratuite</h3><p class="text-sm text-ink-soft">Pour toute commande supérieure à 1000 dhs</p></div>
    </li>
    <li class="flex items-start gap-4 text-burgundy" data-reveal style="--d:.08s">
      <svg {...ic}><rect x="5" y="15" width="26" height="16" rx="1"/><path d="M3 10h30v5H3zM18 10v21"/><path d="M18 10c-3-6-9-6-9-3s6 3 9 3zM18 10c3-6 9-6 9-3s-6 3-9 3z"/></svg>
      <div><h3 class="font-body text-base leading-snug font-semibold tracking-normal text-ink">Options cadeaux</h3><p class="text-sm text-ink-soft">Cartes-cadeaux et coupons-cadeaux disponibles</p></div>
    </li>
    <li class="flex items-start gap-4 text-burgundy" data-reveal style="--d:.16s">
      <svg {...ic}><rect x="7" y="16" width="22" height="16" rx="1"/><path d="M12 16v-4a6 6 0 0 1 12 0v4"/><circle cx="18" cy="24" r="2"/></svg>
      <div><h3 class="font-body text-base leading-snug font-semibold tracking-normal text-ink">Paiement sécurisé</h3><p class="text-sm text-ink-soft">Commande protégée sur notre boutique en ligne</p></div>
    </li>
    <li class="flex items-start gap-4 text-burgundy" data-reveal style="--d:.24s">
      <svg {...ic}><path d="M18 4l3.1 8.6 9.1.3-7.2 5.6 2.5 8.8L18 22l-7.5 5.3 2.5-8.8-7.2-5.6 9.1-.3z"/></svg>
      <div><h3 class="font-body text-base leading-snug font-semibold tracking-normal text-ink">100 % fait au Maroc</h3><p class="text-sm text-ink-soft">Pièces uniques, faites main par des artisanes marocaines</p></div>
    </li>
  </ul>
</section>
