---
import { loadStoreConfig, freeShippingText } from "../lib/store";
import { cmsEnabled, fetchSettings } from "../lib/cms";
import { whatsappLink } from "../data/site";
// Messages are managed in the CMS. Hand-written trust messages (settings → trust) win; otherwise the blocks are built from the store's
// real settings: payment methods, free-delivery threshold, returns policy, contact. Nothing configured: the section is not rendered.
type Block = { title: string; text: string | null; linkLabel: string | null; linkUrl: string | null };
const config = await loadStoreConfig();
let blocks: Block[] = config.trust.slice(0, 4);
if (!blocks.length && cmsEnabled) {
  const s = await fetchSettings().catch(() => null);
  if (s) {
    const pay = s.payment_methods[0];
    const free = freeShippingText(config);
    const wa = whatsappLink("Bonjour Maison Sabra, j’ai une question.", s.contact.whatsapp);
    blocks = [
      pay && { title: pay.label, text: pay.description, linkLabel: null, linkUrl: null },
      free && { title: free, text: s.shipping.delay, linkLabel: config.deliveryPolicyUrl ? "Conditions de livraison" : null, linkUrl: config.deliveryPolicyUrl },
      s.returns.summary && { title: "Retours et échanges", text: s.returns.summary, linkLabel: config.returnsPolicyUrl ? "Politique de retour" : null, linkUrl: config.returnsPolicyUrl },
      wa && { title: "Une question ?", text: "Écrivez-nous, nous vous accompagnons avant et après votre commande.", linkLabel: "Nous écrire sur WhatsApp", linkUrl: wa },
    ].filter((b): b is Block => !!b);
  }
}
const cols = ["", "lg:grid-cols-1", "lg:grid-cols-2", "lg:grid-cols-3", "lg:grid-cols-4"][blocks.length];
// One small line icon per message, matched on its wording; unknown topics get a neutral mark.
const icons: [RegExp, string][] = [
  [/paiement|payer|livraison.*r[ée]gl|cash/i, "M3 7h18v11H3z M3 11h18 M7 15h3"],
  [/livraison|exp[ée]di|colis/i, "M2 6h12v10H2z M14 10h4l3 3v3h-7 M5 18.5a1.5 1.5 0 1 0 3 0 1.5 1.5 0 1 0-3 0 M16 18.5a1.5 1.5 0 1 0 3 0 1.5 1.5 0 1 0-3 0"],
  [/retour|[ée]change|rembours/i, "M4 9h12a4 4 0 0 1 0 8h-3 M8 5L4 9l4 4"],
  [/question|assistance|whatsapp|contact|conseil|aide/i, "M4 5h16v11H9l-5 4z M8 10h8"],
];
const icon = (b: Block) => icons.find(([re]) => re.test(`${b.title} ${b.text ?? ""}`))?.[1] ?? "M12 4l2 6h6l-5 4 2 6-5-4-5 4 2-6-5-4h6z";
---
{blocks.length > 0 && (
  <section class="border-y border-gold/30 bg-ivory py-8 lg:py-10" aria-labelledby="trust-title">
    <h2 id="trust-title" class="sr-only">Acheter en confiance</h2>
    <ul class:list={["m-0 mx-auto grid max-w-(--max) list-none grid-cols-1 gap-x-10 gap-y-6 p-0 px-(--gutter) min-[40rem]:grid-cols-2", cols]}>
      {blocks.map((b) => (
        <li class="flex items-start gap-3.5">
          <svg class="mt-0.5 size-5 shrink-0 text-burgundy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icon(b)} /></svg>
          <div class="grid gap-1">
            <h3 class="m-0 font-body text-[0.875rem] leading-snug font-semibold tracking-normal text-ink">{b.title}</h3>
            {b.text && <p class="m-0 max-w-[36ch] text-[0.8125rem] leading-snug text-ink-soft">{b.text}</p>}
            {b.linkLabel && b.linkUrl && <a class="inline-flex min-h-11 w-fit items-center text-[0.75rem] font-semibold text-burgundy underline decoration-gold decoration-1 underline-offset-[0.4em] hover:text-rose-dusty" href={b.linkUrl}>{b.linkLabel}</a>}
          </div>
        </li>
      ))}
    </ul>
  </section>
)}
