---
import ProductCard from "./ProductCard.astro";
import { bladi, zman } from "../data/products";
const arrow = `<svg width="18" height="12" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 6h15M11 1l5 5-5 5"/></svg>`;
---
<section class="bg-cream-soft py-20 min-[48rem]:py-28" aria-labelledby="bladi-title">
  <div class="mx-auto max-w-(--max) px-(--gutter)">
    <div class="mb-10 grid gap-6 min-[48rem]:mb-14 min-[48rem]:grid-cols-[1fr_auto] min-[48rem]:items-end" data-reveal>
      <div class="grid max-w-[58ch] gap-4">
        <h2 id="bladi-title" class="text-step-3">Nouvel arrivage : Collection Bladi</h2>
        <p class="text-step-0 text-ink-soft">Découvrez nos dernières créations alliant cuir raffiné et tissu berbère artisanal. Des sacs uniques qui célèbrent l’élégance marocaine avec une touche moderne.</p>
      </div>
      <a class="inline-flex items-center gap-3 text-sm font-semibold tracking-[0.08em] text-burgundy uppercase underline decoration-gold decoration-1 underline-offset-8 hover:text-rose-dusty" href="/collection-bladi">Voir la collection <Fragment set:html={arrow} /></a>
    </div>

    <div class="-mx-(--gutter) flex snap-x snap-mandatory gap-4 overflow-x-auto px-(--gutter) pb-2 [scrollbar-width:none] min-[48rem]:mx-0 min-[48rem]:grid min-[48rem]:grid-cols-3 min-[48rem]:gap-8 min-[48rem]:overflow-visible min-[48rem]:px-0">
      {bladi.map((p, i) => <div class="w-[78%] shrink-0 snap-start min-[48rem]:w-auto"><ProductCard product={p} delay={i * 0.1} /></div>)}
    </div>
  </div>
</section>

<section class="bg-cream py-20 min-[48rem]:py-28" aria-labelledby="zman-title">
  <div class="mx-auto max-w-(--max) px-(--gutter)">
    <div class="grid grid-cols-2 gap-x-4 gap-y-10 min-[60rem]:grid-cols-3 min-[60rem]:gap-x-8 min-[60rem]:gap-y-14">
      <div class="relative isolate col-span-2 grid min-h-80 content-between gap-10 overflow-hidden bg-burgundy-deep p-8 text-cream min-[60rem]:col-span-1 min-[60rem]:p-10" data-reveal>
        <svg class="absolute -right-12 -bottom-20 -z-10 w-[62%] opacity-70" viewBox="0 0 400 520" aria-hidden="true">
          <defs><pattern id="star2" width="44" height="44" patternUnits="userSpaceOnUse"><g fill="none" stroke="#C9A24B" stroke-width="1" opacity=".22"><rect x="11" y="11" width="22" height="22"/><rect x="11" y="11" width="22" height="22" transform="rotate(45 22 22)"/></g></pattern></defs>
          <path d="M24 520V206a176 176 0 0 1 352 0v314z" fill="url(#star2)"/>
          <path d="M24 520V206a176 176 0 0 1 352 0v314" fill="none" stroke="#C9A24B" stroke-width="1.5"/>
        </svg>
        <h2 id="zman-title" class="max-w-[12ch] text-step-2 text-cream min-[60rem]:text-[2.25rem]">Nouvelle collection chic &amp; colorée – Z’man</h2>
        <a class="btn self-end justify-self-start" href="/collection-zman">Voir la collection <Fragment set:html={arrow} /></a>
      </div>
      {zman.map((p, i) => <ProductCard product={p} delay={(i % 2) * 0.1} />)}
    </div>
  </div>
</section>
