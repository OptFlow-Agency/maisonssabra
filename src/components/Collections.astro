---
import ProductCard from "./ProductCard.astro";
import type { Product } from "../data/products";
interface Props { bladi: Product[]; zman: Product[] }
const { bladi: bladiAll, zman: zmanAll } = Astro.props;
const bladi = bladiAll.slice(0, 6);
const zman = zmanAll.slice(0, 5);
const arrow = `<svg width="18" height="12" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 6h15M11 1l5 5-5 5"/></svg>`;
---
{bladi.length > 0 && <section class="bg-cream-soft py-24 min-[48rem]:py-36" aria-labelledby="bladi-title">
  <div class="mx-auto max-w-(--max) px-(--gutter)">
    <div class="mb-10 grid gap-6 min-[48rem]:mb-14 min-[48rem]:grid-cols-[1fr_auto] min-[48rem]:items-end" data-reveal>
      <div class="grid max-w-[58ch] gap-4">
        <p class="eyebrow">01 — Collection Bladi</p>
        <h2 id="bladi-title" class="text-step-3">Nouvel arrivage : Collection Bladi</h2>
        <p class="text-step-0 text-ink-soft">Découvrez nos dernières créations alliant cuir raffiné et tissu berbère artisanal. Des sacs uniques qui célèbrent l’élégance marocaine avec une touche moderne.</p>
      </div>
      <a class="inline-flex items-center gap-3 text-sm font-semibold tracking-[0.08em] text-burgundy uppercase underline decoration-gold decoration-1 underline-offset-8 hover:text-rose-dusty" href="/collection-bladi">Voir la collection <Fragment set:html={arrow} /></a>
    </div>

    <div class="-mx-(--gutter) flex snap-x snap-mandatory scroll-px-(--gutter) gap-4 overflow-x-auto overscroll-x-contain px-(--gutter) pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden min-[48rem]:mx-0 min-[48rem]:grid min-[48rem]:grid-cols-3 min-[75rem]:grid-cols-4 min-[48rem]:gap-8 min-[48rem]:overflow-visible min-[48rem]:px-0" data-slider tabindex="0" role="group" aria-roledescription="carrousel" aria-label="Collection Bladi">
      {bladi.map((p, i) => <div class="w-[78%] shrink-0 snap-start min-[48rem]:w-auto" data-slide role="group" aria-roledescription="diapositive" aria-label={`${i + 1} sur ${bladi.length}`}><ProductCard product={p} delay={i * 0.1} /></div>)}
    </div>
    <div class="mt-5 flex justify-center gap-2 min-[48rem]:hidden" data-dots>
      {bladi.map((p, i) => <button class="relative size-2 cursor-pointer rounded-full border-0 bg-gold/35 p-0 transition-[background-color,width] duration-300 before:absolute before:-inset-2.5 before:content-[''] aria-current:w-6 aria-current:bg-gold" type="button" aria-label={`Aller au sac ${i + 1}`} aria-current={i === 0 ? "true" : undefined}></button>)}
    </div>
  </div>
</section>}

{zman.length > 0 && <section class="bg-cream py-24 min-[48rem]:py-36" aria-labelledby="zman-title">
  <div class="mx-auto max-w-(--max) px-(--gutter)">
    <div class="grid grid-cols-2 gap-x-4 gap-y-10 min-[60rem]:grid-cols-3 min-[60rem]:gap-x-8 min-[60rem]:gap-y-14">
      <div class="relative isolate col-span-2 grid min-h-80 content-between gap-10 overflow-hidden bg-burgundy-deep p-8 text-cream min-[60rem]:col-span-1 min-[60rem]:p-10" data-reveal>
        <svg class="absolute -right-12 -bottom-20 -z-10 w-[62%] opacity-70" viewBox="0 0 400 520" aria-hidden="true">
          <defs><pattern id="star2" width="44" height="44" patternUnits="userSpaceOnUse"><g fill="none" stroke="#C9A24B" stroke-width="1" opacity=".22"><rect x="11" y="11" width="22" height="22"/><rect x="11" y="11" width="22" height="22" transform="rotate(45 22 22)"/></g></pattern></defs>
          <path d="M24 520V206a176 176 0 0 1 352 0v314z" fill="url(#star2)"/>
          <path d="M24 520V206a176 176 0 0 1 352 0v314" fill="none" stroke="#C9A24B" stroke-width="1.5"/>
        </svg>
        <p class="eyebrow">02 — Collection Z’man</p>
        <h2 id="zman-title" class="max-w-[12ch] text-step-2 text-cream min-[60rem]:text-[2.25rem]">Nouvelle collection chic &amp; colorée – Z’man</h2>
        <a class="btn self-end justify-self-start" href="/collection-zman">Voir la collection <Fragment set:html={arrow} /></a>
      </div>
      {zman.map((p, i) => <ProductCard product={p} delay={(i % 2) * 0.1} />)}
    </div>
  </div>
</section>}

<script>
  const slider = document.querySelector<HTMLElement>("[data-slider]");
  const dots = [...document.querySelectorAll<HTMLButtonElement>("[data-dots] button")];
  const slides = slider ? [...slider.querySelectorAll<HTMLElement>("[data-slide]")] : [];
  if (slider && slides.length) {
    const mark = (n: number) => dots.forEach((d, i) => (i === n ? d.setAttribute("aria-current", "true") : d.removeAttribute("aria-current")));
    const io = new IntersectionObserver(
      (entries) => entries.forEach((e) => { if (e.isIntersecting) mark(slides.indexOf(e.target as HTMLElement)); }),
      { root: slider, threshold: 0.6 },
    );
    slides.forEach((el) => io.observe(el));
    dots.forEach((d, i) => d.addEventListener("click", () => slides[i].scrollIntoView({ behavior: "smooth", inline: "start", block: "nearest" })));
  }
</script>
