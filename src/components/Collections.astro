---
import type { Product } from "../data/products";
interface Props { bladi: Product[]; zman: Product[] }
const { bladi, zman } = Astro.props;
const featured = zman.find((p) => p.slug === 'zman-rouge') ?? zman[0];
const leather = bladi[0];
---
<section class="bg-white py-16 md:py-24" aria-labelledby="collections-title">
  <div class="mx-auto max-w-(--max) px-(--gutter)">
    <div class="mb-8 flex items-end justify-between gap-6 md:mb-10">
      <div>
        <p class="mb-3 text-[.6875rem] font-semibold uppercase tracking-[.18em] text-burgundy">Maison Sabra</p>
        <h2 id="collections-title" class="m-0 text-step-3">Nos <em>collections.</em></h2>
      </div>
    </div>
    <div class="grid gap-4 md:h-[640px] md:grid-cols-[1.15fr_1fr] md:grid-rows-2 md:gap-5">
      <a href="/collection-zman" class="group relative isolate flex min-h-[440px] flex-col justify-between overflow-hidden bg-card-beige p-7 no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-burgundy md:row-span-2 md:p-10">
        <div class="relative z-10">
          <p class="m-0 text-[.625rem] font-semibold uppercase tracking-[.16em] text-ink-soft">Velours & dorures</p>
          <h3 class="mt-2 text-step-2">Collection Z’man</h3>
        </div>
        {featured && <img class="absolute inset-x-[8%] top-[23%] h-[60%] w-[84%] object-contain transition-transform duration-700 ease-(--ease-out) group-hover:scale-105 motion-reduce:transform-none" src="/img/hero/rouge.webp" alt={featured.alt} width="1000" height="740" loading="lazy" />}
        <span class="relative z-10 flex min-h-11 items-center justify-between text-xs font-semibold text-burgundy">Découvrir la collection <span aria-hidden="true">→</span></span>
      </a>
      <a href="/collection-bladi" class="group relative isolate flex min-h-72 flex-col justify-between overflow-hidden bg-card-beige p-7 no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-burgundy md:p-8">
        <div class="relative z-10 max-w-[55%]">
          <p class="m-0 text-[.625rem] font-semibold uppercase tracking-[.16em] text-ink-soft">Cuir & tissu berbère</p>
          <h3 class="mt-2 text-step-2">Collection Bladi</h3>
        </div>
        {leather && <img class="absolute right-0 top-[8%] h-[84%] w-[52%] object-contain mix-blend-multiply transition-transform duration-700 ease-(--ease-out) group-hover:scale-105 motion-reduce:transform-none" src={leather.img} alt={leather.alt} width="1000" height="999" loading="lazy" />}
        <span class="relative z-10 flex min-h-11 items-center justify-between text-xs font-semibold text-burgundy">Découvrir la collection <span aria-hidden="true">→</span></span>
      </a>
      <a href="/boutique" class="group flex min-h-60 flex-col justify-between bg-burgundy-deep p-7 text-cream-soft no-underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-burgundy md:p-8">
        <div>
          <p class="m-0 text-[.625rem] font-semibold uppercase tracking-[.16em]">Savoir-faire marocain</p>
          <h3 class="mt-3 max-w-[15ch] text-step-2 text-cream-soft">Toute la <em>boutique.</em></h3>
        </div>
        <span class="flex min-h-11 items-center justify-between text-xs font-semibold">Explorer les créations <span class="transition-transform group-hover:translate-x-1 motion-reduce:transform-none" aria-hidden="true">→</span></span>
      </a>
    </div>
  </div>
</section>
