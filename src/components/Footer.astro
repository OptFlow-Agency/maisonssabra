---
import { site } from "../data/site";
const live = "https://maisonsabra.ma";
const cols = [
  { title: "Collections", links: [["Z’man", "/collection-zman"], ["Bladi", "/collection-bladi"], ["Atar · bientôt disponible", ""], ["Toute la boutique", "/boutique"]] },
  { title: "Assistance", links: [["Commandes", `${live}/commandes-maison-sabra/`], ["Livraison", `${live}/livraison-maison-sabra/`], ["Retours et échanges", `${live}/retours-reclamations-maison-sabra/`], ["Annulation de commande", `${live}/annulation-de-commande-maison-sabra/`], ["Cartes-cadeaux", `${live}/cartes-cadeaux-maison-sabra/`], ["Aide (FAQ)", `${live}/aide-faq-maison-sabra/`]] },
  { title: "Informations", links: [["Notre Maison", "/#maison"], ["Nos politiques", `${live}/nos-politiques-maison-sabra/`], ["Politique de confidentialité", `${live}/privacy-policy/`]] },
];
const link = "inline-flex min-h-9 items-center text-cream-soft/85 no-underline transition-colors hover:text-rose focus-visible:text-rose";
---
<footer class="on-dark bg-burgundy-deep text-cream-soft">
  <div class="mx-auto grid max-w-(--max) gap-12 px-(--gutter) pt-14 pb-10 lg:grid-cols-[1.1fr_2fr] lg:gap-24 lg:pt-20">
    <div class="grid content-start gap-5">
      <a class="flex w-fit items-center gap-3 text-cream-soft no-underline" href="/" aria-label="Maison Sabra, accueil">
        <span class="block size-10 bg-cream-soft [mask:url(/img/logo-ms.png)_center/contain_no-repeat]" aria-hidden="true"></span>
        <span class="font-display text-2xl font-semibold tracking-[0.14em] uppercase">Maison Sabra</span>
      </a>
      <p class="m-0 max-w-[36ch] text-cream-soft/85">Sacs artisanaux marocains en velours, cuir et tissu berbère, inspirés du savoir-faire marocain.</p>
      <a class="inline-flex min-h-11 w-fit items-center text-xs font-semibold tracking-[0.14em] text-rose uppercase underline decoration-1 underline-offset-[0.5em] hover:text-cream-soft" href={site.instagram} rel="noopener" target="_blank">Instagram · @maison_sabra</a>
    </div>

    <nav class="grid gap-0 lg:grid-cols-3 lg:gap-8" aria-label="Pied de page" data-footer-nav>
      {cols.map((c, i) => (
        <details class="group/d border-t border-cream-soft/15 last:border-b lg:border-0 lg:last:border-b-0" open={i === 0 ? true : undefined}>
          <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between text-xs font-semibold tracking-[0.16em] uppercase marker:hidden [&::-webkit-details-marker]:hidden lg:min-h-0 lg:cursor-default lg:pb-3">
            {c.title}
            <svg class="size-4 transition-transform duration-300 group-open/d:rotate-180 lg:hidden" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 6 8 10.5 12.5 6"/></svg>
          </summary>
          <ul class="m-0 grid list-none gap-0 p-0 pb-4 text-[0.9375rem] lg:pb-0">
            {c.links.map(([t, h]) => <li>{h ? <a class={link} href={h}>{t}</a> : <span class="inline-flex min-h-9 items-center text-cream-soft/60">{t}</span>}</li>)}
          </ul>
        </details>
      ))}
    </nav>
  </div>

  <div class="mx-auto flex max-w-(--max) flex-wrap items-center justify-between gap-x-8 gap-y-2 border-t border-cream-soft/15 px-(--gutter) py-6 text-sm text-cream-soft/70">
    <p class="m-0">© 2026 Maison Sabra</p>
    <p class="m-0">Powered by Bayoussef Media</p>
  </div>
</footer>

<script>
  // Accordions on mobile; always open and static from the desktop breakpoint.
  const mq = matchMedia("(min-width: 64rem)");
  const groups = document.querySelectorAll<HTMLDetailsElement>("[data-footer-nav] details");
  const sync = () => groups.forEach((d, i) => { if (mq.matches) d.open = true; else if (!d.dataset.touched) d.open = i === 0; });
  groups.forEach((d) => d.querySelector("summary")!.addEventListener("click", (e) => { if (mq.matches) e.preventDefault(); else d.dataset.touched = "1"; }));
  mq.addEventListener("change", sync);
  sync();
</script>
