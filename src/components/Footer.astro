---
const live = "https://maisonsabra.ma";
const cols = [
  { title: "Service client", links: [["Commandes", `${live}/commandes-maison-sabra/`], ["Retours", `${live}/retours-reclamations-maison-sabra/`], ["Cartes-cadeaux", `${live}/cartes-cadeaux-maison-sabra/`], ["Livraison", `${live}/livraison-maison-sabra/`], ["Annulation de commande", `${live}/annulation-de-commande-maison-sabra/`]] },
  { title: "Visitez-nous", links: [["Boutique", "/boutique"], ["Collection Bladi", "/collection-bladi"], ["Collection Z’man", "/collection-zman"], ["À propos de nous", "/#histoire"]] },
  { title: "Informations", links: [["Aide (FAQ)", `${live}/aide-faq-maison-sabra/`], ["Nos politiques", `${live}/nos-politiques-maison-sabra/`], ["Politique de confidentialité", `${live}/privacy-policy/`]] },
];
const social = [["Instagram", "https://www.instagram.com/maison_sabra"], ["Facebook", "https://www.facebook.com/"], ["Pinterest", "https://www.pinterest.com/"]];
---
<div class="on-dark border-b border-gold/40 bg-burgundy px-(--gutter) py-3 text-center text-xs font-medium tracking-[0.18em] text-rose uppercase">
  Achetez maintenant et obtenez 10 % de réduction sur tous les produits.
</div>

<footer class="on-dark relative isolate overflow-hidden bg-burgundy-deep text-white [&_a]:focus-visible:outline-2 [&_a]:focus-visible:outline-offset-4 [&_a]:focus-visible:outline-rose">
  <p class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 m-0 select-none whitespace-nowrap text-center font-display text-[clamp(4rem,20vw,28rem)] leading-[.8] tracking-[-.045em] text-white/[.07]" aria-hidden="true">Maison Sabra</p>
  <div class="mx-auto grid max-w-(--max) gap-12 px-(--gutter) pt-14 pb-12 md:pt-20 md:pb-16 min-[60rem]:grid-cols-[1fr_1.5fr] min-[60rem]:gap-20">
    <section aria-labelledby="news-title" class="grid content-start gap-4">
      <h2 id="news-title" class="text-step-2 text-white">Les nouvelles de la maison</h2>
      <p class="max-w-[40ch] text-sm leading-7 text-white/75">Recevez nos nouveautés et découvrez les prochaines créations Maison Sabra.</p>
      <form class="grid gap-3" novalidate data-newsletter>
        <label class="text-[.625rem] font-semibold tracking-[.16em] uppercase" for="nl-email">Adresse e-mail</label>
        <div class="flex flex-col gap-3 min-[30rem]:flex-row">
          <input class="min-h-13 min-w-0 flex-1 border border-cream/50 bg-transparent px-4 text-cream placeholder:text-cream/60 focus-visible:border-cream focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream" id="nl-email" name="email" type="email" autocomplete="email" inputmode="email" required placeholder="vous@exemple.com" aria-describedby="nl-msg" />
          <button class="min-h-13 cursor-pointer border-0 bg-rose px-5 text-[.625rem] font-semibold uppercase tracking-[.12em] text-burgundy-deep transition-colors hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-rose" type="submit">S’abonner</button>
        </div>
        <p id="nl-msg" class="min-h-6 text-sm text-cream/90" role="status"></p>
      </form>
    </section>

    <nav class="grid grid-cols-2 gap-x-6 gap-y-10 min-[48rem]:grid-cols-3" aria-label="Pied de page">
      {cols.map((c) => (
        <div>
          <h2 class="mb-5 font-body text-[.625rem] font-semibold tracking-[.16em] text-white uppercase">{c.title}</h2>
          <ul class="m-0 grid list-none gap-3 p-0">
            {c.links.map(([t, h]) => <li><a class="inline-flex min-h-6 text-xs leading-relaxed text-white/75 underline decoration-transparent decoration-1 underline-offset-4 transition-colors hover:text-rose hover:decoration-gold" href={h}>{t}</a></li>)}
          </ul>
        </div>
      ))}
    </nav>
  </div>

  <div class="mx-auto flex max-w-(--max) flex-wrap items-center justify-between gap-x-8 gap-y-4 border-t border-white/15 px-(--gutter) pt-6 pb-16 text-xs md:pb-24">
    <a class="flex items-center gap-3 text-cream no-underline" href="/" aria-label="Maison Sabra, accueil">
      <img class="size-9 object-contain brightness-0 invert" src="/img/logo-ms.png" alt="" width="36" height="36" loading="lazy" />
      <span class="font-display text-base font-semibold tracking-[0.12em] uppercase">Maison Sabra</span>
    </a>
    <ul class="m-0 flex list-none gap-6 p-0">
      {social.map(([t, h]) => <li><a class="text-white/75 underline decoration-transparent hover:decoration-gold decoration-1 underline-offset-4 hover:text-rose" href={h} rel="noopener">{t}</a></li>)}
    </ul>
    <p class="text-white/60">© 2026 Maison Sabra. · Powered by Bayoussef Media</p>
  </div>
</footer>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-newsletter]");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const input = form.querySelector<HTMLInputElement>("input")!;
    const msg = form.querySelector<HTMLElement>("#nl-msg")!;
    if (!input.validity.valid) { msg.textContent = "Saisissez une adresse e-mail valide, par exemple nom@exemple.com."; input.setAttribute("aria-invalid", "true"); input.focus(); return; }
    input.removeAttribute("aria-invalid");
    msg.textContent = "Merci ! Vous recevrez nos prochaines nouveautés.";
    form.reset();
  });
</script>
