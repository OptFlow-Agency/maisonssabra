---
// Customer words. Approved reviews from the CMS win; until there are some, the quotes the brand already published stay.
// (The brand films have their own section, so no videos here.)
import { cmsEnabled, fetchReviews } from "../lib/cms";
type Quote = { name: string; quote: string; arabic?: boolean; verified?: boolean };
const published: Quote[] = [
  { name: "Salma R.", quote: "Maison Sabra, c’est bien plus qu’un sac… c’est une œuvre d’art. Dès que je le porte, on me demande d’où il vient. La finition est impeccable, et on sent le travail fait main derrière chaque détail." },
  { name: "Karima", quote: "J’ai été touchée par l’authenticité des produits. Mon sac Maison Sabra m’accompagne partout, il allie tradition et élégance avec une touche marocaine que j’adore. Je recommande à 100 %." },
  { name: "@eddahabitouria", quote: "أحييك مدام بهيجة على ابتكاراتك الرائعة التقيت بك يوم الأحد الماضى كل عروضك كانت تعبر عن اللمسة المغربية مزيد من التألق وبالطبع كنت محضوضة باقتناء قطعتين أفتخر بهما", arabic: true },
];
const cms = cmsEnabled ? await fetchReviews().catch(() => null) : null;
const fromCms: Quote[] = (cms?.reviews ?? []).slice(0, 3).map((r) => ({ name: r.author, quote: r.text, arabic: /[؀-ۿ]/.test(r.text), verified: r.verified }));
const quotes = fromCms.length ? fromCms : published;
---
<section class="bg-ivory py-16 lg:py-24" aria-labelledby="temoignages-title">
  <div class="mx-auto max-w-(--max) px-(--gutter)">
    <div class="mb-10 grid gap-3 lg:mb-14" data-reveal>
      <p class="eyebrow m-0"><span class="h-px w-8 bg-gold" aria-hidden="true"></span>Elles en parlent</p>
      <h2 id="temoignages-title" class="m-0 text-step-2 lg:text-[2.75rem]">Les mots de nos clientes</h2>
    </div>
    <ul class="m-0 grid list-none gap-10 p-0 md:grid-cols-3 md:gap-12">
      {quotes.map((q, i) => (
        <li data-reveal style={`--d:${0.08 * i}s`}>
          <figure class="m-0 grid gap-5 border-t border-gold/40 pt-6">
            <span class="font-display text-5xl leading-[0.5] text-gold" aria-hidden="true">“</span>
            <blockquote class="m-0 font-display text-[1.25rem] leading-[1.45] text-burgundy" lang={q.arabic ? "ar" : "fr"} dir={q.arabic ? "rtl" : undefined}>{q.quote}</blockquote>
            <figcaption class="text-[0.75rem] font-semibold tracking-[0.14em] text-ink-soft uppercase">{q.name}{q.verified && <span class="font-medium normal-case tracking-normal"> · Achat vérifié</span>}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
