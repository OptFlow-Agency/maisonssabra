---
// Founder story with a portrait of the founder in a framed print.
const photo: {
  src: string;
  srcset: string;
  alt: string;
  w: number;
  h: number;
} | null = {
  src: "/img/home/founder-800.webp",
  srcset: "/img/home/founder-480.webp 480w, /img/home/founder-800.webp 800w",
  alt: "Portrait de Bahija Benhamid, fondatrice de Maison Sabra",
  w: 800,
  h: 994,
};
---

<section
  class="overflow-hidden bg-ivory py-16 lg:py-28"
  aria-labelledby="founder-title"
>
  <div class="mx-auto grid max-w-(--max) items-center gap-12 px-(--gutter) lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-20">
    <!-- Portrait: a cream print, slightly turned inside a hairline gold frame. -->
    <figure
      class="relative mx-auto m-0 w-[min(82%,24rem)] lg:mx-0 lg:w-[min(100%,24rem)]"
      data-reveal
    >
      <span
        class="absolute -inset-3 rotate-[-2deg] border border-gold/50"
        aria-hidden="true"
      ></span>
      <div class="relative bg-[#f8f1e6] p-3 pb-5 shadow-[0_24px_40px_-28px_rgb(77_2_6/0.45)] ring-1 ring-gold/25">
        <div class="relative aspect-[4/5] overflow-hidden bg-card-beige">
          {photo ? (
            <img
              class="absolute inset-0 size-full object-cover object-top"
              src={photo.src}
              srcset={photo.srcset}
              sizes="(min-width: 1024px) 24rem, 82vw"
              alt={photo.alt}
              width={photo.w}
              height={photo.h}
              loading="lazy"
              decoding="async"
            />
          ) : (
            <span
              class="absolute inset-0 grid place-items-center"
              aria-hidden="true"
            >
              <span class="block size-16 bg-gold/35 [mask:url(/img/logo-ms.png)_center/contain_no-repeat]"></span>
            </span>
          )}
        </div>
        <figcaption class="mt-4 grid justify-items-center gap-1 text-center">
          <span class="font-display text-[1.375rem] leading-none text-burgundy">
            Bahija Benhamid
          </span>
          <span class="text-[0.625rem] font-semibold tracking-[0.2em] text-rose-dusty uppercase">
            Fondatrice &amp; créatrice
          </span>
        </figcaption>
      </div>
    </figure>

    <div class="grid gap-6" data-reveal style="--d:.1s">
      <p class="eyebrow m-0">
        <span class="h-px w-8 bg-gold" aria-hidden="true"></span>Fondée par
        Bahija Benhamid
      </p>
      <h2
        id="founder-title"
        class="m-0 text-step-2 leading-[1.1] text-balance lg:text-[3rem]"
      >
        L’Âme de Maison Sabra
      </h2>
      <h2 class="-mt-3 text-balance lg:text-[3rem]">
        <em class="text-rose-dusty">Notre Histoire</em>
      </h2>
      <p class="m-0 max-w-[60ch] text-ink-soft">
        Icône de création et gardienne du patrimoine marocain, Bahija Benhamid a
        fondé Maison Sabra avec une vision intemporelle : transformer le noble
        héritage artisanal de Fès et Marrakech en pièces de haute maroquinerie
        contemporaine.
      </p>
      <p class="m-0 max-w-[60ch] text-ink-soft">
        Chaque sac naît d’une passion profonde pour le Tarz traditionnel, le
        velours de soie pourpre et le travail du cuir tanné au végétal. Plus
        qu’un accessoire, Maison Sabra est un pont entre générations, où chaque
        broderie et chaque point d’or racontent la patience, la dignité et
        l’excellence des femmes et artisans maîtres du Royaume.
      </p>
      <div class="mt-2 flex items-end justify-between gap-6 border-t border-gold/30 pt-6">
        <p class="m-0 grid gap-1">
          <span class="font-display text-[1.5rem] leading-none text-burgundy italic">
            Bahija Benhamid
          </span>
          <span class="text-[0.625rem] font-semibold tracking-[0.16em] text-ink-soft uppercase">
            Atelier Maison Sabra · Maroc
          </span>
        </p>
        <span
          class="block size-8 shrink-0 bg-burgundy/50 [mask:url(/img/logo-ms.png)_center/contain_no-repeat]"
          aria-hidden="true"
        ></span>
      </div>
    </div>
  </div>

  <!-- Brand story film, below the founder text. Loads only when played. -->
  <figure
    class="relative mx-auto m-0 mt-16 w-full max-w-[88rem] px-(--gutter) lg:mt-28"
    data-reveal
  >
    <div class="relative">
      <span
        class="absolute -inset-3 border border-gold/60 lg:-inset-5"
        aria-hidden="true"
      ></span>
      <div class="relative bg-burgundy p-2 shadow-[0_50px_80px_-30px_rgb(77_2_6/0.65)] ring-1 ring-gold/50 lg:p-4">
        <video
          class="aspect-video w-full bg-ink"
          controls
          playsinline
          preload="none"
          poster="/assets/videos/brand-story.jpg"
          aria-label="L’histoire de Maison Sabra racontée par Bahija Benhamid"
        >
          <source src="/assets/videos/brand-story.mp4" type="video/mp4" />
        </video>
        <button
          type="button"
          class="group/p absolute inset-0 m-auto grid size-20 cursor-pointer place-items-center rounded-full border border-gold/70 bg-burgundy/80 text-ivory shadow-[0_12px_40px_rgb(0_0_0/0.45)] backdrop-blur-sm transition-[transform,background-color,opacity] duration-300 hover:scale-110 hover:bg-burgundy focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-gold data-[hidden=true]:pointer-events-none data-[hidden=true]:opacity-0 lg:size-28"
          data-story-play
          aria-label="Lire le film de Maison Sabra"
        >
          <svg
            class="ml-1 size-8 fill-current lg:size-11"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M7 4.5v15a1 1 0 0 0 1.5.86l12.5-7.5a1 1 0 0 0 0-1.72L8.5 3.64A1 1 0 0 0 7 4.5Z" />
          </svg>
        </button>
      </div>
    </div>
  </figure>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>(
    "video[poster$='brand-story.jpg']",
  );
  const play = document.querySelector<HTMLButtonElement>("[data-story-play]");
  if (video && play) {
    const sync = () => play.setAttribute("data-hidden", String(!video.paused));
    play.addEventListener("click", () => {
      void video.play();
    });
    video.addEventListener("play", sync);
    video.addEventListener("pause", sync);
    video.addEventListener("ended", sync);
  }
</script>
