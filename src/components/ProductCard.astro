---
import type { Product } from "../data/products";
import { discount, srcset, variant } from "../data/products";
import { fmtMad } from "../lib/offer";
import { ShoppingBag } from "lucide-static";
/** `subgrid` is kept for callers; cards now align by stretching to equal height, with the price row pinned to the bottom. */
interface Props { product: Product; eager?: boolean; subgrid?: boolean }
const { product: p, eager = false } = Astro.props;
const sizes = "(min-width: 64rem) 22vw, (min-width: 48rem) 30vw, 46vw";
const collection = p.collection === "zman" ? "Collection Z’man" : "Collection Bladi";
const href = `/produit/${p.slug}`;
// Savings only from a real price pair: a crossed-out price that isn't above the current one shows nothing.
const saving = p.was && p.was > p.price ? p.was - p.price : 0;
const pct = discount(p);
// One corner tag at most: the real reduction, else genuine low stock from the CMS, else "Nouveau".
const tag = pct > 0 ? `−${pct} %` : p.stock != null && p.stock > 0 ? `Plus que ${p.stock}` : p.isNew ? "Nouveau" : null;
// Colour previews: only variants the CMS ships with their own photo.
const swatches = (p.variants ?? []).filter((v) => v.img).slice(0, 5);
const id = `card-${p.slug}`;
// The older bundled alternates (/maisonsabra/alt) only ship a 480 rendition next to the 800px original.
const img2Set = p.img2 && (p.img2.includes("/alt/") ? `${variant(p.img2, 480)} 480w, ${p.img2} 800w` : srcset(p.img2));
const bag = ShoppingBag.replace(/\swidth="\d+"/, ' width="18"').replace(/\sheight="\d+"/, ' height="18"').replace(/stroke-width="[\d.]+"/, 'stroke-width="1.6"').replace("<svg", '<svg aria-hidden="true" focusable="false"');
---
<article class="group/card @container flex h-full flex-col overflow-hidden rounded-xl bg-white shadow-[0_1px_0_rgb(176_130_49/0.18)] ring-1 ring-gold/15 transition-shadow duration-500 can-hover:hover:shadow-[0_18px_40px_-24px_rgb(77_2_6/0.35)]" aria-labelledby={`${id}-name`} data-card>
  <!-- Photo on white, like a boutique shelf; the worn view crossfades in on hover. -->
  <a class="relative block aspect-square overflow-hidden bg-white focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-burgundy" href={href} tabindex="-1" aria-hidden="true">
    <img class={`absolute inset-0 size-full object-cover transition-[opacity,scale] duration-700 ease-(--ease-out) ${p.img2 ? "can-hover:group-hover/card:opacity-0" : "can-hover:group-hover/card:scale-[1.04]"}`} src={variant(p.img, 800)} srcset={srcset(p.img)} sizes={sizes} alt={p.alt} width="1000" height="988" loading={eager ? "eager" : "lazy"} decoding="async" data-card-img />
    {p.img2 && <img class="absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-700 ease-(--ease-out) can-hover:group-hover/card:opacity-100" src={p.img2.includes("/alt/") ? p.img2 : variant(p.img2, 800)} srcset={img2Set} sizes={sizes} alt="" width="1000" height="988" loading="lazy" decoding="async" />}
    {tag && <span class="absolute top-2.5 right-2.5 rounded-full border border-gold/40 bg-white/95 px-2 py-0.5 text-[0.625rem] font-semibold tracking-[0.06em] text-burgundy tabular-nums">{tag}</span>}
  </a>

  <!-- Details on warm beige: collection, name in the display serif, price row pinned to the bottom. -->
  <div class="flex flex-1 flex-col bg-card-beige px-3.5 pt-3 pb-3.5 md:px-4 md:pt-3.5 md:pb-4">
    <p class="m-0 text-[0.625rem] leading-none font-medium tracking-[0.08em] text-ink-soft">{collection}</p>
    <h3 id={`${id}-name`} class="m-0 mt-1.5 font-display text-[1.0625rem] leading-[1.2] font-semibold tracking-normal text-burgundy-deep md:text-[1.1875rem]">
      <a class="text-burgundy-deep no-underline hover:text-burgundy focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-burgundy" href={href}>{p.name}</a>
    </h3>

    {swatches.length > 1 && (
      <ul class="m-0 mt-2.5 flex list-none flex-wrap gap-1.5 p-0" aria-label={`Coloris de ${p.name}`}>
        {swatches.map((v, i) => (
          <li><button type="button" class="block size-6 cursor-pointer overflow-hidden rounded-full border border-gold/30 bg-white p-0 aria-pressed:ring-1 aria-pressed:ring-burgundy aria-pressed:ring-offset-1 aria-pressed:ring-offset-card-beige focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-burgundy" aria-pressed={i === 0 ? "true" : "false"} aria-label={v.name} title={v.name} data-swatch={variant(v.img!, 480)}><img class="size-full object-cover" src={variant(v.img!, 480)} alt="" width="24" height="24" loading="lazy" decoding="async" /></button></li>
        ))}
      </ul>
    )}

    <!-- Price row pinned to the bottom; savings on its own line so nothing wraps on narrow cards. Lining figures keep prices even. -->
    <div class="mt-auto pt-3">
      <div class="flex items-center justify-between gap-2">
        <p class="m-0 flex min-w-0 flex-wrap items-baseline gap-x-2 [font-variant-numeric:lining-nums_tabular-nums]">
          <span class="sr-only">Prix :</span><span class="font-display text-[1.125rem] leading-none font-semibold whitespace-nowrap text-burgundy @[15rem]:text-[1.375rem]">{fmtMad(p.price)}</span>
          {saving > 0 && <><span class="sr-only">au lieu de</span><s class="hidden font-display text-[0.9375rem] leading-none whitespace-nowrap text-ink-soft @[15rem]:inline">{fmtMad(p.was!)}</s></>}
        </p>
        <button class="grid size-9 shrink-0 cursor-pointer place-items-center rounded-full border border-burgundy/35 bg-white text-burgundy transition-colors duration-300 hover:border-burgundy hover:bg-burgundy hover:text-cream-soft data-[added=true]:border-burgundy data-[added=true]:bg-burgundy data-[added=true]:text-cream-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-burgundy md:size-10" type="button" data-quick-add={p.slug} data-name={p.name} data-price={p.price} data-img={variant(p.img, 480)} aria-label={`Ajouter au panier : ${p.name}`} title="Ajouter au panier">
          <Fragment set:html={bag} />
        </button>
      </div>
      {saving > 0 ? <p class="m-0 mt-1.5 flex flex-wrap items-baseline gap-x-1.5 text-[0.6875rem] font-semibold text-rose-dusty tabular-nums"><s class="font-normal whitespace-nowrap text-ink-soft @[15rem]:hidden">{fmtMad(p.was!)}</s><span class="whitespace-nowrap"><span class="hidden @[15rem]:inline">Économisez </span><span class="@[15rem]:hidden">−</span>{fmtMad(saving)}</span></p> : <p class="m-0 mt-1.5 h-[1.1em] text-[0.6875rem]" aria-hidden="true"></p>}
    </div>
  </div>
</article>
