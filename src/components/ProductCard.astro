---
import type { Product } from "../data/products";
import { discount, srcset, tone, variant } from "../data/products";
interface Props { product: Product; delay?: number; eager?: boolean }
const { product: p, delay = 0, eager = false } = Astro.props;
const sizes = "(min-width: 60rem) 30vw, (min-width: 48rem) 45vw, 78vw";
const label = p.collection === "zman" ? "Collection Z’man" : "Collection Bladi";
const href = `/produit/${p.slug}`;
---
<article class="group/card relative flex flex-col bg-white shadow-[0_1px_0_rgb(176_130_49/0.25)] transition-shadow duration-500 can-hover:hover:shadow-[0_24px_40px_-24px_rgb(77_2_6/0.45)]" data-reveal style={`--d:${delay}s`}>
  <div class="relative aspect-[5/6] overflow-hidden" style={`background:${tone(p)}`}>
    <a class="block size-full" href={href} tabindex="-1" aria-hidden="true">
      <img class={`absolute inset-0 size-full object-cover mix-blend-multiply brightness-[1.06] transition-[opacity,scale] duration-700 ease-(--ease-out) ${p.img2 ? "" : "can-hover:group-hover/card:scale-105"}`} src={variant(p.img, 800)} srcset={srcset(p.img)} sizes={sizes} alt={p.alt} width="1000" height="988" loading={eager ? "eager" : "lazy"} decoding="async" />
      {p.img2 && <img class="absolute inset-0 size-full object-cover opacity-0 mix-blend-multiply brightness-[1.06] transition-opacity duration-700 ease-(--ease-out) can-hover:group-hover/card:opacity-100" src={variant(p.img2, 480)} srcset={`${variant(p.img2, 480)} 480w, ${p.img2} 800w`} sizes={sizes} alt="" width="800" height="790" loading="lazy" decoding="async" />}
    </a>

    <div class="pointer-events-none absolute top-3 left-3 flex flex-col items-start gap-1.5">
      {discount(p) > 0 && <span class="bg-burgundy px-2 py-1 text-[0.6875rem] leading-none font-semibold tracking-[0.08em] text-cream uppercase">−{discount(p)} %</span>}
      {p.isNew && <span class="bg-cream-soft px-2 py-1 text-[0.6875rem] leading-none font-semibold tracking-[0.08em] text-burgundy uppercase">Nouveau</span>}
    </div>

    <button class="group/heart icon-btn absolute top-1.5 right-1.5 text-burgundy-deep" type="button" data-wish={p.name} aria-pressed="false" aria-label={`Ajouter à la liste de souhaits : ${p.name}`}>
      <svg class="transition-[fill,scale] duration-300 group-aria-pressed/heart:scale-110 group-aria-pressed/heart:fill-current" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true"><path d="M12 20s-7.5-4.6-7.5-10A4.3 4.3 0 0 1 12 7.4 4.3 4.3 0 0 1 19.5 10c0 5.4-7.5 10-7.5 10z"/></svg>
    </button>
  </div>

  <div class="grid flex-1 grid-cols-[1fr_auto] items-end gap-x-4 gap-y-1 px-4 pt-4 pb-4 min-[48rem]:px-5 min-[48rem]:pb-5">
    <p class="col-span-2 m-0 text-[0.625rem] leading-none font-semibold tracking-[0.22em] text-ink-soft uppercase">{label}</p>
    <h3 class="col-span-2 mb-2 text-[1.0625rem] leading-snug min-[30rem]:text-step-1">
      <a class="text-burgundy no-underline hover:text-rose-dusty" href={href}>{p.name}</a>
    </h3>
    <button class="order-last row-span-1 grid size-11 shrink-0 cursor-pointer place-items-center self-center rounded-none border-0 bg-transparent p-0 text-burgundy ring-1 ring-gold/70 transition-colors duration-300 ring-inset hover:bg-burgundy hover:text-cream hover:ring-burgundy" type="button" data-add={p.slug} data-name={p.name} data-price={p.price} data-img={variant(p.img, 480)} aria-label={`Ajouter au panier : ${p.name}`}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
    </button>
    <p class="m-0 flex flex-wrap items-baseline self-center gap-x-2.5 text-ink tabular-nums">
      <span class="sr-only">Prix actuel :</span><span class="font-semibold tracking-[0.04em]">{p.price} dhs</span>
      {discount(p) > 0 && <><span class="sr-only">Prix initial :</span><s class="text-sm text-ink-soft">{p.was} dhs</s></>}
    </p>
  </div>
</article>
