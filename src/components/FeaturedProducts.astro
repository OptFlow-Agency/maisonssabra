---
import type { Product } from '../data/products';
import CatalogCard from './CatalogCard.astro';
interface Props { products: Product[]; title?: string; intro?: string; page?: boolean; showFilters?: boolean }
const { products, title = "Toute la boutique", intro = "Paiement à la livraison partout au Maroc · Inspection avant règlement", page = false, showFilters = true } = Astro.props;
const Heading = page ? "h1" : "h2";
const filters = [{ key: 'all', label: 'Tous les produits' }, { key: 'zman', label: 'Collection Z’man' }, { key: 'bladi', label: 'Collection Bladi' }];
---
<section class:list={["bg-white", page ? "pt-8 pb-16 md:pb-24" : "py-16 md:py-24"]} aria-labelledby="shop-title" data-featured-shop>
  <div class="mx-auto max-w-(--max) px-(--gutter)">
    <div class="mb-10 flex flex-col justify-between gap-6 border-b border-gold/25 pb-7 lg:flex-row lg:items-end">
      <div>
        <p class="mb-3 text-[.625rem] font-semibold uppercase tracking-[.24em] text-rose-dusty">Boutique & commande express</p>
        <Heading id="shop-title" class="m-0 text-step-3">{title}</Heading>
        <p class="mt-3 text-xs text-ink-soft">{intro}</p>
      </div>
      {showFilters && <div class="flex max-w-full gap-1 overflow-x-auto border border-gold/25 bg-card-beige p-1" role="group" aria-label="Filtrer les produits">
        {filters.map((filter) => <button type="button" data-product-filter={filter.key} aria-pressed={filter.key === 'all' ? 'true' : 'false'} class="min-h-11 shrink-0 cursor-pointer border-0 bg-transparent px-4 text-[.625rem] font-medium uppercase tracking-[.1em] text-ink-soft aria-pressed:bg-burgundy aria-pressed:text-white focus-visible:outline-2 focus-visible:outline-burgundy focus-visible:outline-offset-2">{filter.label}</button>)}
      </div>}
    </div>
    {products.length === 0 && <p class="text-sm text-ink-soft">Aucun produit dans cette collection pour le moment.</p>}
    <div class="grid grid-cols-1 gap-5 min-[480px]:grid-cols-2 lg:grid-cols-4">
      {products.map((p) => <CatalogCard product={p} />)}
    </div>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-featured-shop]').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-product-filter]');
    const cards = root.querySelectorAll<HTMLElement>('[data-product-collection]');
    buttons.forEach((button) => button.addEventListener('click', () => {
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      cards.forEach((card) => { card.hidden = button.dataset.productFilter !== 'all' && card.dataset.productCollection !== button.dataset.productFilter; });
    }));
  });
</script>
