---
// Brand mission + craftsmanship, merged into one editorial section (it used to be two that repeated each other).
// The CMS wins wherever it has content: the "story" section (mission) and a verified "craftsmanship" story (close-ups).
// Copy only states what's verifiable: handmade, Moroccan heritage, velvet, gold detailing, berber fabric.
import type { Home } from "../lib/home";
interface Props { mission: Home["mission"]; craft: Home["craft"] }
const { mission, craft } = Astro.props;

// The lead frame is landscape at the atelier photo's own ratio (1376×768), so the default photo shows whole; a CMS image is cropped to it.
const lead = {
  src: "/img/atelier-workshop.webp", srcset: undefined, w: 1376, h: 768,
  alt: "Une artisane en blouse blanche coud un sac en cuir et tissu berbère dans son atelier marocain",
};
type Detail = { src: string; srcset?: string; w: number; h: number; alt: string; label: string; cls: string };
const details: Detail[] = craft?.details.length
  ? craft.details.slice(0, 1).map((d) => ({ src: d.pic.src, srcset: d.pic.srcset, w: d.pic.w ?? 1000, h: d.pic.h ?? 1000, alt: d.pic.alt || d.label, label: d.label, cls: "object-center" }))
  : [
      { src: "/img/home/detail-928.webp", srcset: "/img/home/detail-640.webp 640w, /img/home/detail-928.webp 928w", w: 928, h: 1152, label: "Velours brodé et dorures", alt: "Gros plan sur la broderie dorée d’un sac Z’man, sa chaîne et son fermoir", cls: "scale-[1.35] object-[45%_70%]" },
    ];
const portrait = { src: "/img/home/hero-895.webp", srcset: "/img/home/hero-640.webp 640w, /img/home/hero-895.webp 895w", w: 895, h: 1200, alt: "Une femme en caftan brodé présente un sac Z’man en velours fleuri et dorures, dans un riad aux murs de zellige", cls: "object-[50%_55%]" };
const paragraphs = mission?.paragraphs.length
  ? mission.paragraphs
  : [
      "Maison Sabra fait vivre l’héritage artisanal marocain à travers des sacs pensés pour la femme d’aujourd’hui.",
      "Velours brodé, dorures, cuir et tissu berbère : chaque pièce est façonnée à la main, avec le soin du détail qui fait la différence.",
    ];
const detail = details[0];
---
<section id="maison" class="scroll-mt-24 overflow-hidden bg-ivory py-16 sm:py-20 lg:py-28" aria-labelledby="heritage-title">
  <div class="mx-auto grid max-w-(--max) px-(--gutter)">
    <h2 id="heritage-title" class="sr-only">{mission?.heading || "Un héritage marocain, une élégance contemporaine."}</h2>

    <!-- Bento cards, each with its own colour and voice. -->
    <ul class="m-0 grid list-none gap-4 p-0 lg:min-h-[46rem] lg:grid-cols-12 lg:grid-rows-2 lg:gap-6" aria-label="L’atelier et le savoir-faire en images">
      <li class="flex min-w-0 flex-col overflow-hidden rounded-[1.75rem] bg-white shadow-[0_20px_50px_-30px_rgba(60,20,30,0.35)] lg:col-span-7 lg:row-span-2">
        <div class="relative aspect-[1376/768] w-full lg:aspect-auto lg:min-h-0 lg:flex-1">
          <img class="absolute inset-0 size-full object-cover object-center" src={lead.src} width={lead.w} height={lead.h} alt={lead.alt} loading="lazy" decoding="async" sizes="(min-width: 64rem) 55vw, 100vw" />
          <span class="absolute top-4 left-4 inline-flex min-h-8 items-center rounded-full bg-ivory/92 px-4 text-xs font-semibold tracking-[0.12em] text-burgundy uppercase backdrop-blur-sm">L’atelier</span>
        </div>
        <div class="grid gap-3 p-6 sm:p-9">
          <h3 class="m-0 font-display text-3xl leading-tight text-burgundy sm:text-4xl">Façonné à la main</h3>
          <p class="m-0 max-w-[52ch] text-base text-ink-soft sm:text-lg">{paragraphs[1] ?? paragraphs[0]}</p>
        </div>
      </li>
      {detail && (
        <li class="grid min-w-0 grid-cols-[1fr_minmax(0,1fr)] overflow-hidden rounded-[1.75rem] bg-burgundy text-ivory lg:col-span-5">
          <div class="grid content-center gap-3 p-6 sm:p-8">
            <span class="inline-flex min-h-7 w-fit items-center rounded-full border border-gold/60 px-3 text-[0.6875rem] font-semibold tracking-[0.12em] text-gold uppercase">Savoir-faire</span>
            <h3 class="m-0 font-display text-2xl leading-tight text-ivory sm:text-3xl">{detail.label}</h3>
            <p class="m-0 text-sm text-ivory/80 sm:text-base">Broderies et dorures travaillées pièce par pièce.</p>
          </div>
          <div class="relative min-h-60 overflow-hidden">
            <img class={`absolute inset-0 size-full object-cover ${detail.cls}`} src={detail.src} srcset={detail.srcset} sizes="(min-width: 64rem) 24vw, 45vw" width={detail.w} height={detail.h} alt={detail.alt} loading="lazy" decoding="async" />
          </div>
        </li>
      )}
      <li class="grid min-w-0 grid-cols-[1fr_minmax(0,1fr)] overflow-hidden rounded-[1.75rem] bg-[#e9d3b0] lg:col-span-5">
        <div class="grid content-center gap-3 p-6 sm:p-8">
          <span class="inline-flex min-h-7 w-fit items-center rounded-full bg-burgundy px-3 text-[0.6875rem] font-semibold tracking-[0.12em] text-ivory uppercase">Z’man</span>
          <h3 class="m-0 font-display text-2xl leading-tight text-burgundy sm:text-3xl">Pensé pour elle</h3>
          <p class="m-0 text-sm text-ink-soft sm:text-base">Des sacs à porter au quotidien comme en soirée.</p>
        </div>
        <div class="relative min-h-60 overflow-hidden">
          <img class={`absolute inset-0 size-full object-cover ${portrait.cls}`} src={portrait.src} srcset={portrait.srcset} sizes="(min-width: 64rem) 24vw, 45vw" width={portrait.w} height={portrait.h} alt={portrait.alt} loading="lazy" decoding="async" />
        </div>
      </li>
    </ul>
  </div>
</section>
