---
import { site } from "../data/site";
const from = site.freeShippingFrom.toLocaleString("fr-FR");
---
<div class="on-dark bg-burgundy-deep text-rose" role="region" aria-label="Information livraison">
  <p class="m-0 mx-auto flex min-h-9 max-w-(--max) items-center justify-center px-(--gutter) text-center text-[0.75rem] leading-snug font-medium tracking-[0.1em] uppercase">
    Livraison offerte dès {from} MAD d’achat
  </p>
</div>
