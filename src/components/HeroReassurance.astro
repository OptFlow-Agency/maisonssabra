---
const items = [
  { title: '100% fait main', text: 'Ateliers de Fès & Marrakech', icon: 'craft' },
  { title: 'Livraison offerte', text: 'Partout au Maroc en 48h', icon: 'truck' },
  { title: 'Paiement à la livraison', text: 'Réglez après inspection', icon: 'payment' },
  { title: 'Échange garanti', text: '3 jours sans tracas', icon: 'exchange' },
];
const paths: Record<string, string> = {
  craft: 'M12 2l3 2 3-.2.8 3L22 9l-1.5 3L21 15l-3 1-1 3-3-.2L12 21l-2-2.2-3 .2-1-3-3-1 .5-3L2 9l3.2-2.2.8-3 3 .2L12 2z M8 11l3 3 5-6',
  truck: 'M2 5h13v12H2z M15 10h4l3 4v3h-7 M5 17a2 2 0 1 0 4 0 2 2 0 1 0-4 0 M16 17a2 2 0 1 0 4 0 2 2 0 1 0-4 0',
  payment: 'M5 5h17v12H5z M2 9v11h17 M15 11a2 2 0 1 0-4 0 2 2 0 1 0 4 0 M7 8h1 M19 14h1',
  exchange: 'M8 3H4v4 M4 3l4 4 M4 7a9 9 0 0 0 6 14 M16 21h4v-4 M20 21l-4-4 M20 17a9 9 0 0 0-6-14 M14 8l-4 8',
};
---
<section aria-label="Les engagements Maison Sabra" class="border-b border-gold/35 bg-cream-soft py-4">
  <ul class="mx-auto m-0 flex max-w-(--max) list-none items-center justify-between gap-6 overflow-x-auto px-(--gutter)">
    {items.map((item) => (
      <li class="flex shrink-0 items-center gap-3">
        <svg class="size-5 shrink-0 text-rose-dusty" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[item.icon]} /></svg>
        <div>
          <p class="m-0 text-[.6875rem] font-semibold uppercase tracking-[.12em] whitespace-nowrap text-burgundy">{item.title}</p>
          <p class="m-0 mt-0.5 text-[.625rem] whitespace-nowrap font-medium text-ink-soft">{item.text}</p>
        </div>
      </li>
    ))}
  </ul>
</section>
