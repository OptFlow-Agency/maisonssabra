---
// Reassurance band under the hero, as an endless slow slider.
// One readable copy for assistive tech; a duplicate (aria-hidden) closes the loop seamlessly.
// Pauses on hover; under reduced motion it stands still and scrolls by hand instead.
import { BadgeCheck, Banknote, RefreshCcw, Truck } from "lucide-static";

const icon = (svg: string) =>
  svg.replace(/\swidth="\d+"/, ' width="22"').replace(/\sheight="\d+"/, ' height="22"').replace(/stroke-width="[\d.]+"/, 'stroke-width="1.6"').replace("<svg", '<svg aria-hidden="true" focusable="false"');

const items = [
  { title: "100% fait main", text: "Ateliers de Fès & Marrakech", icon: icon(BadgeCheck) },
  { title: "Livraison offerte", text: "Partout au Maroc en 48h", icon: icon(Truck) },
  { title: "Paiement à la livraison", text: "Réglez après inspection", icon: icon(Banknote) },
  { title: "Échange garanti", text: "3 jours sans tracas", icon: icon(RefreshCcw) },
];
---
<section aria-label="Les engagements Maison Sabra" class="reassure group/r overflow-hidden border-b border-gold/35 bg-ivory py-4 lg:py-5">
  <div class="reassure-track flex w-max">
    {[0, 1, 2, 3].map((copy) => (
      <ul class="m-0 flex shrink-0 list-none items-center p-0" aria-hidden={copy > 0 ? "true" : undefined}>
        {items.map((item) => (
          <li class="flex shrink-0 items-center gap-3.5 px-10 lg:px-16">
            <span class="shrink-0 text-rose-dusty" set:html={item.icon}></span>
            <span class="grid gap-0.5">
              <span class="text-[.75rem] font-semibold tracking-[.14em] whitespace-nowrap text-burgundy uppercase">{item.title}</span>
              <span class="text-[.75rem] font-medium whitespace-nowrap text-ink-soft">{item.text}</span>
            </span>
          </li>
        ))}
      </ul>
    ))}
  </div>
</section>

<style>
  /* Four identical copies, moved by one copy's width (25 %): the loop never shows a gap, even on very wide screens. */
  .reassure-track { animation: reassure 36s linear infinite; }
  .reassure:hover .reassure-track { animation-play-state: paused; }
  @keyframes reassure { to { transform: translateX(-25%); } }
  @media (prefers-reduced-motion: reduce) {
    .reassure { overflow-x: auto; scrollbar-width: none; }
    .reassure::-webkit-scrollbar { display: none; }
    .reassure-track { animation: none; }
  }
</style>
