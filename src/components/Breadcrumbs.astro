---
interface Props { crumbs: [name: string, path: string][] }
const { crumbs } = Astro.props;
---
<nav aria-label="Fil d’Ariane">
  <ol class="m-0 flex list-none flex-wrap items-center gap-x-2 gap-y-1 p-0 text-sm text-ink-soft">
    {crumbs.map(([name, path], i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <span aria-hidden="true" class="text-gold">/</span>}
        {i === crumbs.length - 1
          ? <span aria-current="page" class="text-burgundy">{name}</span>
          : <a class="text-ink-soft underline decoration-transparent underline-offset-4 hover:text-burgundy hover:decoration-gold" href={path}>{name}</a>}
      </li>
    ))}
  </ol>
</nav>
