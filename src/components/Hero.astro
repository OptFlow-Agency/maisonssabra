---
---
<section class="on-dark relative isolate overflow-hidden bg-[radial-gradient(120%_90%_at_78%_40%,#7d2140_0%,var(--color-burgundy)_45%,var(--color-burgundy-deep)_100%)] text-cream" aria-labelledby="hero-title" data-hero>
  <div class="grain pointer-events-none absolute inset-0 -z-10 opacity-50 mix-blend-soft-light" aria-hidden="true"></div>

  <div class="mx-auto grid min-h-[min(46rem,calc(100svh-var(--header-h)-2.75rem))] max-w-(--max) gap-8 px-(--gutter) pt-16 split:grid-cols-[1.05fr_1fr] split:items-stretch split:gap-12 split:pt-12">
    <div class="relative z-2 grid content-center justify-items-start gap-6 will-change-transform [transform:translate3d(0,calc(var(--p,0)*36px),0)]">
      <h1 id="hero-title" class="text-step-4 leading-[0.95] font-medium tracking-[-0.01em] text-cream">
        <span class="block overflow-hidden pb-[0.08em]"><span class="block animate-rise motion-reduce:animate-none">Éclats</span></span>
        <span class="block overflow-hidden pb-[0.08em]"><span class="block animate-[rise_1.1s_0.12s_var(--ease-out)_both] motion-reduce:animate-none">de <em class="text-rose">Tradition</em></span></span>
      </h1>
      <p class="max-w-[26ch] animate-[fade_1s_0.45s_var(--ease-out)_both] text-step-1 leading-snug opacity-92 motion-reduce:animate-none split:max-w-[28ch]">
        Des créations artisanales inspirées du patrimoine marocain
      </p>
      <a class="btn animate-[fade_1s_0.6s_var(--ease-out)_both] motion-reduce:animate-none" href="/boutique">
        Découvrir la collection
        <svg width="18" height="12" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 6h15M11 1l5 5-5 5"/></svg>
      </a>
    </div>

    <figure class="relative m-0 w-[min(100%,26rem)] self-end justify-self-center will-change-transform [transform:translate3d(0,calc(var(--p,0)*-48px),0)] split:w-[min(100%,34rem,calc((100svh-11rem)/1.3))] split:justify-self-end">
      <svg class="w-full" viewBox="0 0 400 520" aria-hidden="true" preserveAspectRatio="xMidYMax meet">
        <defs>
          <pattern id="star" width="44" height="44" patternUnits="userSpaceOnUse">
            <g fill="none" stroke="#C9A24B" stroke-width="1" opacity=".16">
              <rect x="11" y="11" width="22" height="22"/>
              <rect x="11" y="11" width="22" height="22" transform="rotate(45 22 22)"/>
            </g>
          </pattern>
          <clipPath id="archclip"><path d="M24 520V206a176 176 0 0 1 352 0v314z"/></clipPath>
        </defs>
        <path d="M24 520V206a176 176 0 0 1 352 0v314z" fill="#4A0F22"/>
        <rect width="400" height="520" fill="url(#star)" clip-path="url(#archclip)"/>
        <path class="animate-[draw_1.8s_0.2s_var(--ease-out)_forwards] [stroke-dasharray:1] [stroke-dashoffset:1] motion-reduce:animate-none motion-reduce:[stroke-dashoffset:0]" pathLength="1" d="M24 520V206a176 176 0 0 1 352 0v314" fill="none" stroke="#C9A24B" stroke-width="1.5"/>
        <path class="animate-[draw_1.8s_0.45s_var(--ease-out)_forwards] [stroke-dasharray:1] [stroke-dashoffset:1] motion-reduce:animate-none motion-reduce:[stroke-dashoffset:0]" pathLength="1" d="M40 520V206a160 160 0 0 1 320 0v314" fill="none" stroke="#C9A24B" stroke-width="1" opacity=".55"/>
      </svg>
      <img
        class="absolute bottom-[18%] left-1/2 h-auto w-[98%] max-w-none -translate-x-1/2 animate-[lift_1.4s_0.35s_var(--ease-out)_both] drop-shadow-[0_28px_22px_rgb(20_4_10/0.5)] motion-reduce:animate-none"
        src="/img/hero-zman-beige.webp" width="831" height="613"
        alt="Sac Z’man en velours beige brodé de motifs dorés, avec sa chaîne dorée"
        fetchpriority="high" decoding="async"
      />
      <figcaption class="absolute inset-x-[6%] bottom-0 bg-linear-to-b from-transparent to-burgundy-deep/85 to-55% px-2 py-4 text-center">
        <a class="border-b border-gold pb-0.5 text-step--1 font-medium tracking-[0.08em] text-cream uppercase no-underline hover:text-rose" href="/collection-zman">Sac Z’man – Velours Beige Brodé Doré</a>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  import { onScroll } from "../scripts/smooth";
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  if (hero && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    let h = hero.offsetHeight;
    addEventListener("resize", () => (h = hero.offsetHeight), { passive: true });
    onScroll((y) => hero.style.setProperty("--p", String(Math.min(y / h, 1))));
  }

</script>
