---
import type { Home } from "../lib/home";
interface Props { hero: Home["hero"] }
const { hero } = Astro.props;
const body = hero?.body || "Des créations inspirées de nos traditions, pensées pour accompagner la femme contemporaine.";
const tagline = hero?.heading || "L’héritage marocain, porté avec élégance.";
const cta = hero?.cta ?? { label: "Découvrir les collections", href: "#collections" };
const img = hero?.image;
const arrow = `<svg width="18" height="12" viewBox="0 0 18 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 6h15M11 1l5 5-5 5"/></svg>`;
---
<!-- Full-bleed, full-height campaign scene: the brand set large on oxblood, the photograph filling the other side and feathered into it. -->
<section class="on-dark relative grid min-h-[calc(100svh-6.5rem)] grid-rows-[minmax(0,48svh)_auto] bg-burgundy-deep text-cream-soft lg:min-h-[max(34rem,calc(100svh-7.5rem))] lg:grid-cols-[5fr_7fr] lg:grid-rows-1" aria-labelledby="hero-title">
  <figure class="relative m-0 overflow-hidden lg:order-2">
    <div class="hero-img absolute inset-0">
    <picture>
      {hero?.imageMobile && <source media="(max-width: 63.99rem)" srcset={hero.imageMobile.srcset ?? hero.imageMobile.src} sizes="100vw" />}
      <img
        class="absolute inset-0 size-full object-cover object-[42%_40%] [mask-image:linear-gradient(to_bottom,#000_72%,transparent)] lg:[mask-image:linear-gradient(to_right,transparent,#000_16%)]"
        src={img?.src ?? "/img/home/hero-895.webp"}
        srcset={img ? img.srcset : "/img/home/hero-640.webp 640w, /img/home/hero-895.webp 895w"}
        sizes="(min-width: 64rem) 58vw, 100vw"
        width={img?.w ?? 895} height={img?.h ?? 1200}
        alt={img?.alt || "Une femme tient un sac Z’man en velours multicolore rehaussé de dorures, dans un riad aux zelliges, devant un olivier"}
        fetchpriority="high" decoding="async"
      />
    </picture>
    </div>
  </figure>

  <div class="relative z-10 flex flex-col justify-center gap-5 px-(--gutter) pt-1 pb-8 lg:order-1 lg:gap-9 lg:py-16 lg:pr-0 lg:pl-[max(var(--gutter),calc((100vw-var(--max))/2+var(--gutter)))]">
    <h1 id="hero-title" class="m-0 grid gap-4 lg:gap-6">
      <span class="font-display text-[3.25rem] leading-[0.9] font-medium tracking-[-0.01em] text-cream-soft min-[48rem]:text-[5.5rem] xl:text-[7rem]"><span class="block overflow-hidden pb-[0.08em]"><span class="block animate-rise">Maison</span></span><span class="block overflow-hidden pb-[0.08em]"><span class="block animate-rise italic text-rose [animation-delay:.12s]">Sabra</span></span></span>
      <span class="animate-fade [animation-delay:.5s] max-w-[24ch] text-balance font-body text-[0.8125rem] leading-snug font-medium tracking-[0.14em] text-rose uppercase lg:text-sm">{tagline}</span>
    </h1>
    <p class="animate-fade [animation-delay:.7s] m-0 max-w-[36ch] text-cream-soft/80 lg:text-[1.0625rem]">{body}</p>
    <div class="animate-fade [animation-delay:.9s] flex flex-wrap items-center gap-x-7 gap-y-3">
      <a class="inline-flex min-h-12 items-center gap-3 rounded-full bg-rose px-7 text-xs font-semibold tracking-[0.12em] text-burgundy-deep uppercase no-underline transition-colors duration-300 hover:bg-cream-soft" href={cta.href}>{cta.label} <Fragment set:html={arrow} /></a>
      <a class="inline-flex min-h-11 items-center text-sm font-medium text-cream-soft underline decoration-rose decoration-1 underline-offset-[0.45em] hover:text-rose" href="/boutique">Toute la boutique</a>
    </div>
    <p class="m-0 mt-6 hidden text-[0.6875rem] tracking-[0.16em] text-cream-soft/60 uppercase lg:block">[ Défiler pour découvrir ]</p>
  </div>
</section>
