---
import { films } from "../data/films";
const i = (d: string) => `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const icons = {
  play: i('<path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/>'),
  pause: i('<path d="M8 5.5v13M16 5.5v13"/>'),
  sound: i('<path d="M4 9.5h3.5L12 6v12l-4.5-3.5H4z" fill="currentColor"/><path d="M15.5 9a4.2 4.2 0 0 1 0 6M18 6.8a7.5 7.5 0 0 1 0 10.4"/>'),
  muted: i('<path d="M4 9.5h3.5L12 6v12l-4.5-3.5H4z" fill="currentColor"/><path d="M16 9.5l5 5M21 9.5l-5 5"/>'),
  full: i('<path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/>'),
  prev: i('<path d="M15 5l-7 7 7 7"/>'),
  next: i('<path d="M9 5l7 7-7 7"/>'),
};
// The stack shows five cards (centre + two each side), so a short list is repeated to fill it; dots still count real films.
const slides = Array.from({ length: films.length > 1 && films.length < 5 ? films.length * 2 : films.length }, (_, i) => ({ f: films[i % films.length], k: i % films.length }));
const nav = "grid size-11 shrink-0 cursor-pointer place-items-center rounded-full border border-burgundy/40 bg-transparent p-0 text-burgundy transition-colors duration-200 hover:bg-burgundy hover:text-cream-soft";
const ctl = "grid size-11 shrink-0 cursor-pointer place-items-center rounded-full border-0 bg-transparent p-0 text-cream-soft transition-colors duration-200 hover:bg-cream-soft/15";
---
<section id="notre-histoire" class="scroll-mt-24 overflow-hidden bg-ivory py-16 lg:py-28" aria-labelledby="films-title">
  <div class="mx-auto grid max-w-(--max) gap-10 px-(--gutter) lg:gap-14">
    <div class="mx-auto grid max-w-[44rem] justify-items-center gap-4 text-center lg:gap-5" data-reveal>
      <p class="eyebrow m-0"><span class="h-px w-8 bg-gold" aria-hidden="true"></span>En mouvement<span class="h-px w-8 bg-gold" aria-hidden="true"></span></p>
      <h2 id="films-title" class="m-0 text-step-3 leading-[1.02] text-balance">L’univers Maison Sabra, en mouvement.</h2>
      <p class="m-0 max-w-[48ch] text-ink-soft">Découvrez nos créations, nos matières et les histoires qui les inspirent.</p>
      <p class="m-0 max-w-[46ch] font-display text-[1.25rem] leading-snug text-burgundy italic lg:text-[1.375rem]">Maison Sabra réinterprète l’héritage marocain en sacs pensés pour la femme d’aujourd’hui : des textures riches, des motifs qui racontent, une allure contemporaine.</p>
    </div>

    <!-- Stacked carousel: every card shares one grid cell; the script tucks each one behind the active (centre) card, smaller and softer the further it sits. It advances on its own and holds while hovered, focused or playing. -->
    <div class="grid gap-8">
      <div class="relative grid touch-pan-y justify-items-center select-none [&>*]:[grid-area:1/1]" data-films-track role="region" aria-roledescription="carrousel" aria-label="Films Maison Sabra" tabindex="0">
        {slides.map(({ f, k: n }, i) => (
          <figure class="group/f relative m-0 w-[min(64vw,18rem)] transition-[transform,opacity,filter] duration-700 ease-(--ease-out) will-change-transform motion-reduce:transition-none lg:w-[20rem]" data-film={n} data-active={i === 0 ? "true" : "false"} aria-label={`${n + 1} sur ${films.length} : ${f.title}`}>
            <div class="relative">
              <div class="group/frame relative aspect-[9/16] overflow-hidden rounded-xl bg-burgundy-deep shadow-[0_30px_50px_-30px_rgb(77_2_6/0.55)]" data-state="idle" data-frame>
                <video class="size-full object-cover" src={f.src} poster={f.poster} preload="none" playsinline loop width="540" height="960" aria-label={f.label}></video>
                <button class="absolute inset-0 grid cursor-pointer place-items-center border-0 bg-transparent p-0 text-burgundy" type="button" data-play aria-label={`Lire la vidéo : ${f.title}`}>
                  <span class="grid size-16 place-items-center rounded-full bg-cream-soft/92 pl-0.5 transition-[scale,opacity] duration-300 group-data-[state=playing]/frame:scale-90 group-data-[state=playing]/frame:opacity-0 group-data-[state=loading]/frame:opacity-0 group-data-[active=false]/f:opacity-0 can-hover:group-hover/f:scale-105" aria-hidden="true" set:html={icons.play}></span>
                </button>
                <p class="pointer-events-none absolute inset-x-0 top-1/2 m-0 hidden -translate-y-1/2 text-center text-sm text-cream-soft group-data-[state=loading]/frame:block group-data-[state=error]/frame:block" data-status role="status"></p>
                <button class="absolute inset-x-4 top-1/2 mt-8 hidden min-h-11 cursor-pointer border border-cream-soft bg-burgundy-deep/70 text-xs font-semibold tracking-[0.12em] text-cream-soft uppercase group-data-[state=error]/frame:block" type="button" data-retry>Réessayer</button>
                <div class="absolute inset-x-0 bottom-0 hidden items-center gap-1 bg-linear-to-t from-burgundy-deep/85 to-transparent px-2 pt-8 pb-1.5 group-data-[state=paused]/frame:flex group-data-[state=playing]/frame:flex" data-bar>
                  <button class={ctl} type="button" data-toggle aria-label={`Mettre en pause : ${f.title}`} set:html={icons.pause}></button>
                  <input class="h-11 min-w-0 flex-1 cursor-pointer accent-gold" type="range" min="0" max="1000" value="0" aria-label={`Position de lecture : ${f.title}`} data-seek />
                  <button class={ctl} type="button" data-mute aria-pressed="false" aria-label={`Couper le son : ${f.title}`} set:html={icons.sound}></button>
                  <button class={ctl} type="button" data-full aria-label={`Plein écran : ${f.title}`} set:html={icons.full}></button>
                </div>
              </div>
              <!-- Side cards: one click brings the film to the centre; its own controls stay inert until then. -->
              <button class="absolute inset-0 hidden cursor-pointer rounded-xl border-0 bg-transparent p-0 group-data-[active=false]/f:block" type="button" tabindex="-1" data-focus aria-label={`Afficher la vidéo : ${f.title}`}></button>
            </div>
            <figcaption class="mt-4 grid gap-0.5 text-center transition-opacity duration-500 group-data-[active=false]/f:opacity-0">
              <span class="font-display text-xl leading-tight text-burgundy">{f.title}</span>
              <span class="text-sm text-ink-soft">{f.note}</span>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="flex items-center justify-center gap-5" role="group" aria-label="Parcourir les vidéos">
        <button class={`${nav}`} type="button" data-films-prev aria-label="Vidéo précédente" set:html={icons.prev}></button>
        <div class="flex items-center gap-2.5">
          {films.map((f, n) => <button class="h-2.5 w-2.5 cursor-pointer rounded-full border-0 bg-burgundy/25 p-0 transition-[width,background-color] duration-300 aria-[current=true]:w-7 aria-[current=true]:bg-burgundy" type="button" data-dot={n} aria-current={n === 0 ? "true" : "false"} aria-label={`Vidéo ${n + 1} : ${f.title}`}></button>)}
        </div>
        <button class={`${nav}`} type="button" data-films-next aria-label="Vidéo suivante" set:html={icons.next}></button>
      </div>
    </div>
  </div>
  <template data-icons>
    <i data-i="pause" set:html={icons.pause}></i><i data-i="play" set:html={icons.play}></i><i data-i="sound" set:html={icons.sound}></i><i data-i="muted" set:html={icons.muted}></i>
  </template>
</section>

<script>
  const track = document.querySelector<HTMLElement>("[data-films-track]");
  if (track) {
    const tpl = document.querySelector<HTMLTemplateElement>("[data-icons]")!;
    const icon = (k: string) => tpl.content.querySelector<HTMLElement>(`[data-i="${k}"]`)!.innerHTML;
    const films = [...track.querySelectorAll<HTMLElement>("[data-film]")].map((fig) => {
      const frame = fig.querySelector<HTMLElement>("[data-frame]")!;
      return {
        fig, frame,
        video: fig.querySelector<HTMLVideoElement>("video")!,
        play: fig.querySelector<HTMLButtonElement>("[data-play]")!,
        toggle: fig.querySelector<HTMLButtonElement>("[data-toggle]")!,
        seek: fig.querySelector<HTMLInputElement>("[data-seek]")!,
        mute: fig.querySelector<HTMLButtonElement>("[data-mute]")!,
        full: fig.querySelector<HTMLButtonElement>("[data-full]")!,
        retry: fig.querySelector<HTMLButtonElement>("[data-retry]")!,
        status: fig.querySelector<HTMLElement>("[data-status]")!,
        title: fig.querySelector("figcaption span")!.textContent || "",
      };
    });

    const pauseOthers = (except?: HTMLVideoElement) => films.forEach((f) => { if (f.video !== except && !f.video.paused) f.video.pause(); });

    films.forEach((f) => {
      const { video, frame } = f;
      const set = (s: string, msg = "") => { frame.dataset.state = s; f.status.textContent = msg; };
      const label = (playing: boolean) => {
        f.play.setAttribute("aria-label", `${playing ? "Mettre en pause" : "Lire la vidéo"} : ${f.title}`);
        f.toggle.setAttribute("aria-label", `${playing ? "Mettre en pause" : "Lire"} : ${f.title}`);
        f.toggle.innerHTML = icon(playing ? "pause" : "play");
      };
      const start = () => {
        pauseOthers(video);
        set("loading", "Chargement…");
        video.play().catch((err: Error) => { if (err.name !== "AbortError") set("error", "Cette vidéo ne peut pas être lue."); });
      };
      const togglePlay = () => (video.paused ? start() : video.pause());
      f.play.addEventListener("click", togglePlay);
      f.toggle.addEventListener("click", togglePlay);
      f.retry.addEventListener("click", () => { video.load(); start(); });
      video.addEventListener("waiting", () => { if (!video.paused) set("loading", "Chargement…"); });
      video.addEventListener("playing", () => { set("playing"); label(true); });
      video.addEventListener("pause", () => { if (frame.dataset.state !== "error" && frame.dataset.state !== "idle") set("paused"); label(false); });
      video.addEventListener("error", () => set("error", "Cette vidéo est momentanément indisponible."));
      video.addEventListener("timeupdate", () => { if (video.duration) f.seek.value = String(Math.round((video.currentTime / video.duration) * 1000)); });
      f.seek.addEventListener("input", () => { if (video.duration) video.currentTime = (Number(f.seek.value) / 1000) * video.duration; });
      f.mute.addEventListener("click", () => {
        video.muted = !video.muted;
        f.mute.setAttribute("aria-pressed", String(video.muted));
        f.mute.setAttribute("aria-label", `${video.muted ? "Activer le son" : "Couper le son"} : ${f.title}`);
        f.mute.innerHTML = icon(video.muted ? "muted" : "sound");
      });
      f.full.addEventListener("click", () => {
        const v = video as HTMLVideoElement & { webkitEnterFullscreen?: () => void };
        if (v.requestFullscreen) v.requestFullscreen().catch(() => {});
        else v.webkitEnterFullscreen?.();
      });
    });

    // A film leaves the screen: it stops. Nothing keeps playing out of sight.
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (!e.isIntersecting) { const f = films.find((x) => x.fig === e.target); if (f && !f.video.paused) f.video.pause(); }
    }), { root: null, threshold: 0.25 });
    films.forEach((f) => io.observe(f.fig));

    // 3D carousel: each card sits at a circular offset from the active one (…-1, 0, +1…), so the films loop.
    const prev = document.querySelector<HTMLButtonElement>("[data-films-prev]");
    const next = document.querySelector<HTMLButtonElement>("[data-films-next]");
    const dots = [...document.querySelectorAll<HTMLButtonElement>("[data-dot]")];
    const n = films.length;
    let active = 0;
    const place = () => {
            films.forEach((f, i) => {
        let o = i - active;
        if (o > n / 2) o -= n;
        if (o < -n / 2) o += n;
        const d = Math.abs(o);
        const on = o === 0;
        // Straight cards side by side with a small gap: each step out is scaled down, faded and softened.
        // Offsets (in card widths) = previous half-widths + gap + this half-width, so the gap stays even whatever the scale.
        const scale = [1, 0.85, 0.72, 0.6];
        const gap = 0.06;
        let x = 0;
        for (let k = 1; k <= Math.min(d, 3); k++) x += scale[k - 1] / 2 + gap + scale[k] / 2;
        f.fig.style.transform = `translateX(${x * 100 * Math.sign(o)}%) scale(${scale[Math.min(d, 3)]})`;
        f.fig.style.zIndex = String(10 - d);
        f.fig.style.opacity = ["1", "0.9", "0.55", "0"][Math.min(d, 3)];
        f.fig.style.filter = ["none", "blur(1px) saturate(0.85)", "blur(2.5px) saturate(0.75)", "none"][Math.min(d, 3)];
        f.fig.style.pointerEvents = d > 2 ? "none" : "";
        f.fig.dataset.active = String(on);
        f.frame.inert = !on;
        f.fig.setAttribute("aria-hidden", String(!on));
      });
      dots.forEach((b, i) => b.setAttribute("aria-current", String(i === Number(films[active].fig.dataset.film))));
    };
    const go = (i: number) => {
      const to = ((i % n) + n) % n;
      if (to === active) return;
      pauseOthers();
      active = to;
      place();
    };
    prev?.addEventListener("click", () => go(active - 1));
    next?.addEventListener("click", () => go(active + 1));
    // A dot jumps to the nearest card showing that film.
    dots.forEach((b, k) => b.addEventListener("click", () => {
      let best = active, dist = Infinity;
      films.forEach((f, i) => {
        if (Number(f.fig.dataset.film) !== k) return;
        const o = Math.abs(((i - active + n + n / 2) % n) - n / 2);
        if (o < dist) { dist = o; best = i; }
      });
      go(best);
    }));
    films.forEach((f, i) => f.fig.querySelector("[data-focus]")!.addEventListener("click", () => go(i)));
    track.addEventListener("keydown", (e) => {
      if ((e.target as HTMLElement).matches("input")) return;
      if (e.key === "ArrowLeft") { e.preventDefault(); go(active - 1); }
      if (e.key === "ArrowRight") { e.preventDefault(); go(active + 1); }
    });
    // Swipe (touch or mouse drag), ignored on the seek bar.
    let x0: number | null = null;
    track.addEventListener("pointerdown", (e) => { x0 = (e.target as HTMLElement).matches("input") ? null : e.clientX; });
    track.addEventListener("pointerup", (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 40) go(active + (dx < 0 ? 1 : -1));
    });
    addEventListener("resize", place);
    place();

    // Autoplay: loops forever, but holds while the pointer is over the carousel, focus is inside it, a film is playing,
    // the section is off screen, or the visitor prefers reduced motion.
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const area = track.parentElement!;
    let hovered = false, visible = false;
    area.addEventListener("pointerenter", (e) => { if (e.pointerType === "mouse") hovered = true; });
    area.addEventListener("pointerleave", () => { hovered = false; });
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }, { threshold: 0.3 }).observe(track);
    setInterval(() => {
      const busy = hovered || !visible || reduce.matches || document.hidden || area.contains(document.activeElement) || films.some((f) => !f.video.paused);
      if (!busy) go(active + 1);
    }, 3500);
  }
</script>
