---
import { films } from "../data/films";
const i = (d: string) => `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const icons = {
  play: i('<path d="M8 5.5v13l10.5-6.5z" fill="currentColor"/>'),
  pause: i('<path d="M8 5.5v13M16 5.5v13"/>'),
  sound: i('<path d="M4 9.5h3.5L12 6v12l-4.5-3.5H4z" fill="currentColor"/><path d="M15.5 9a4.2 4.2 0 0 1 0 6M18 6.8a7.5 7.5 0 0 1 0 10.4"/>'),
  muted: i('<path d="M4 9.5h3.5L12 6v12l-4.5-3.5H4z" fill="currentColor"/><path d="M16 9.5l5 5M21 9.5l-5 5"/>'),
  full: i('<path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/>'),
  prev: i('<path d="M15 5l-7 7 7 7"/>'),
  next: i('<path d="M9 5l7 7-7 7"/>'),
};
const ctl = "grid size-11 shrink-0 cursor-pointer place-items-center rounded-full border-0 bg-transparent p-0 text-cream-soft transition-colors duration-200 hover:bg-cream-soft/15";
---
<section id="notre-histoire" class="on-dark scroll-mt-16 overflow-hidden bg-burgundy py-16 text-cream-soft lg:py-28" aria-labelledby="films-title">
  <div class="mx-auto grid max-w-(--max) gap-8 px-(--gutter) lg:grid-cols-[minmax(0,19rem)_minmax(0,1fr)] lg:gap-16">
    <div class="grid content-start gap-4 lg:gap-6" data-reveal>
      <h2 id="films-title" class="text-step-2 text-cream-soft lg:text-[2.75rem]">L’univers Maison Sabra, en mouvement.</h2>
      <p class="m-0 max-w-[36ch] text-cream-soft/80">Découvrez nos créations, nos matières et les histoires qui les inspirent.</p>
      <p class="m-0 max-w-[36ch] border-t border-gold/50 pt-4 font-display text-[1.25rem] leading-snug text-cream-soft">Maison Sabra réinterprète l’héritage marocain en sacs pensés pour la femme d’aujourd’hui : des textures riches, des motifs qui racontent, une allure contemporaine.</p>
      <div class="mt-4 hidden items-center gap-2 lg:flex" aria-label="Parcourir les vidéos" role="group">
        <button class={`${ctl} border border-cream-soft/40`} type="button" data-films-prev aria-label="Vidéos précédentes" set:html={icons.prev}></button>
        <button class={`${ctl} border border-cream-soft/40`} type="button" data-films-next aria-label="Vidéos suivantes" set:html={icons.next}></button>
      </div>
    </div>

    <div class="-mx-(--gutter) min-w-0 lg:mx-0">
      <div class="flex snap-x snap-mandatory gap-4 overflow-x-auto overscroll-x-contain scroll-px-(--gutter) px-(--gutter) pb-2 [scrollbar-width:none] focus-visible:outline-offset-4 [&::-webkit-scrollbar]:hidden lg:scroll-px-0 lg:px-0" data-films-track role="region" aria-roledescription="carrousel" aria-label="Films Maison Sabra" tabindex="0">
        {films.map((f, n) => (
          <figure class="group/f m-0 w-[66vw] max-w-[17rem] shrink-0 snap-start min-[30rem]:w-[17rem]" data-film aria-label={`${n + 1} sur ${films.length}`}>
            <div class="group/frame relative aspect-[9/16] overflow-hidden rounded-[1.25rem] bg-burgundy-deep" data-state="idle" data-frame>
              <video class="size-full object-cover" src={f.src} poster={f.poster} preload="none" playsinline loop width="540" height="960" aria-label={f.label}></video>
              <button class="absolute inset-0 grid cursor-pointer place-items-center border-0 bg-transparent p-0 text-burgundy" type="button" data-play aria-label={`Lire la vidéo : ${f.title}`}>
                <span class="grid size-16 place-items-center rounded-full bg-cream-soft/92 pl-0.5 transition-[scale,opacity] duration-300 group-data-[state=playing]/frame:scale-90 group-data-[state=playing]/frame:opacity-0 group-data-[state=loading]/frame:opacity-0 can-hover:group-hover/f:scale-105" aria-hidden="true" set:html={icons.play}></span>
              </button>
              <p class="pointer-events-none absolute inset-x-0 top-1/2 m-0 hidden -translate-y-1/2 text-center text-sm text-cream-soft group-data-[state=loading]/frame:block group-data-[state=error]/frame:block" data-status role="status"></p>
              <button class="absolute inset-x-4 top-1/2 mt-8 hidden min-h-11 cursor-pointer border border-cream-soft bg-burgundy-deep/70 text-xs font-semibold tracking-[0.12em] text-cream-soft uppercase group-data-[state=error]/frame:block" type="button" data-retry>Réessayer</button>
              <div class="absolute inset-x-0 bottom-0 hidden items-center gap-1 bg-linear-to-t from-burgundy-deep/85 to-transparent px-2 pt-8 pb-1.5 group-data-[state=paused]/frame:flex group-data-[state=playing]/frame:flex" data-bar>
                <button class={ctl} type="button" data-toggle aria-label={`Mettre en pause : ${f.title}`} set:html={icons.pause}></button>
                <input class="h-11 min-w-0 flex-1 cursor-pointer accent-gold" type="range" min="0" max="1000" value="0" aria-label={`Position de lecture : ${f.title}`} data-seek />
                <button class={ctl} type="button" data-mute aria-pressed="false" aria-label={`Couper le son : ${f.title}`} set:html={icons.sound}></button>
                <button class={ctl} type="button" data-full aria-label={`Plein écran : ${f.title}`} set:html={icons.full}></button>
              </div>
            </div>
            <figcaption class="mt-3 grid gap-0.5">
              <span class="font-display text-xl leading-tight text-cream-soft">{f.title}</span>
              <span class="text-sm text-cream-soft/75">{f.note}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
  <template data-icons>
    <i data-i="pause" set:html={icons.pause}></i><i data-i="play" set:html={icons.play}></i><i data-i="sound" set:html={icons.sound}></i><i data-i="muted" set:html={icons.muted}></i>
  </template>
</section>

<script>
  const track = document.querySelector<HTMLElement>("[data-films-track]");
  if (track) {
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const tpl = document.querySelector<HTMLTemplateElement>("[data-icons]")!;
    const icon = (k: string) => tpl.content.querySelector<HTMLElement>(`[data-i="${k}"]`)!.innerHTML;
    const films = [...track.querySelectorAll<HTMLElement>("[data-film]")].map((fig) => {
      const frame = fig.querySelector<HTMLElement>("[data-frame]")!;
      return {
        fig, frame,
        video: fig.querySelector<HTMLVideoElement>("video")!,
        play: fig.querySelector<HTMLButtonElement>("[data-play]")!,
        toggle: fig.querySelector<HTMLButtonElement>("[data-toggle]")!,
        seek: fig.querySelector<HTMLInputElement>("[data-seek]")!,
        mute: fig.querySelector<HTMLButtonElement>("[data-mute]")!,
        full: fig.querySelector<HTMLButtonElement>("[data-full]")!,
        retry: fig.querySelector<HTMLButtonElement>("[data-retry]")!,
        status: fig.querySelector<HTMLElement>("[data-status]")!,
        title: fig.querySelector("figcaption span")!.textContent || "",
      };
    });

    const pauseOthers = (except?: HTMLVideoElement) => films.forEach((f) => { if (f.video !== except && !f.video.paused) f.video.pause(); });

    films.forEach((f) => {
      const { video, frame } = f;
      const set = (s: string, msg = "") => { frame.dataset.state = s; f.status.textContent = msg; };
      const label = (playing: boolean) => {
        f.play.setAttribute("aria-label", `${playing ? "Mettre en pause" : "Lire la vidéo"} : ${f.title}`);
        f.toggle.setAttribute("aria-label", `${playing ? "Mettre en pause" : "Lire"} : ${f.title}`);
        f.toggle.innerHTML = icon(playing ? "pause" : "play");
      };
      const start = () => {
        pauseOthers(video);
        set("loading", "Chargement…");
        video.play().catch((err: Error) => { if (err.name !== "AbortError") set("error", "Cette vidéo ne peut pas être lue."); });
      };
      const togglePlay = () => (video.paused ? start() : video.pause());
      f.play.addEventListener("click", togglePlay);
      f.toggle.addEventListener("click", togglePlay);
      f.retry.addEventListener("click", () => { video.load(); start(); });
      video.addEventListener("waiting", () => { if (!video.paused) set("loading", "Chargement…"); });
      video.addEventListener("playing", () => { set("playing"); label(true); });
      video.addEventListener("pause", () => { if (frame.dataset.state !== "error" && frame.dataset.state !== "idle") set("paused"); label(false); });
      video.addEventListener("error", () => set("error", "Cette vidéo est momentanément indisponible."));
      video.addEventListener("timeupdate", () => { if (video.duration) f.seek.value = String(Math.round((video.currentTime / video.duration) * 1000)); });
      f.seek.addEventListener("input", () => { if (video.duration) video.currentTime = (Number(f.seek.value) / 1000) * video.duration; });
      f.mute.addEventListener("click", () => {
        video.muted = !video.muted;
        f.mute.setAttribute("aria-pressed", String(video.muted));
        f.mute.setAttribute("aria-label", `${video.muted ? "Activer le son" : "Couper le son"} : ${f.title}`);
        f.mute.innerHTML = icon(video.muted ? "muted" : "sound");
      });
      f.full.addEventListener("click", () => {
        const v = video as HTMLVideoElement & { webkitEnterFullscreen?: () => void };
        if (v.requestFullscreen) v.requestFullscreen().catch(() => {});
        else v.webkitEnterFullscreen?.();
      });
    });

    // A film leaves the screen: it stops. Nothing keeps playing out of sight.
    const io = new IntersectionObserver((entries) => entries.forEach((e) => {
      if (!e.isIntersecting) { const f = films.find((x) => x.fig === e.target); if (f && !f.video.paused) f.video.pause(); }
    }), { root: null, threshold: 0.25 });
    films.forEach((f) => io.observe(f.fig));

    // Desktop arrows: scroll by one card, never hijack the wheel.
    const prev = document.querySelector<HTMLButtonElement>("[data-films-prev]");
    const next = document.querySelector<HTMLButtonElement>("[data-films-next]");
    const step = () => (films[0].fig.getBoundingClientRect().width || 272) + 16;
    const sync = () => {
      if (!prev || !next) return;
      prev.disabled = track.scrollLeft < 4;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      [prev, next].forEach((b) => b.classList.toggle("opacity-40", b.disabled));
    };
    prev?.addEventListener("click", () => track.scrollBy({ left: -step(), behavior: reduce.matches ? "auto" : "smooth" }));
    next?.addEventListener("click", () => track.scrollBy({ left: step(), behavior: reduce.matches ? "auto" : "smooth" }));
    track.addEventListener("scroll", sync, { passive: true });
    addEventListener("resize", sync);
    sync();
  }
</script>
