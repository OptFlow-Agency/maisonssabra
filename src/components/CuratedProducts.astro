---
import ProductCard from "./ProductCard.astro";
import type { Product } from "../data/products";
interface Props { products: Product[]; heading?: string | null; intro?: string | null }
const { products, heading, intro } = Astro.props;
---
{products.length > 0 && (
  <section id="pieces" class="scroll-mt-24 bg-ivory py-16 lg:py-24" aria-labelledby="pieces-title">
    <div class="mx-auto max-w-(--max) px-(--gutter)">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-x-8 gap-y-4 lg:mb-12" data-reveal>
        <div class="grid gap-3">
          <p class="eyebrow m-0"><span class="h-px w-8 bg-gold" aria-hidden="true"></span>La sélection</p>
          <h2 id="pieces-title" class="m-0 text-step-2 lg:text-[2.75rem]">{heading || "Nos pièces emblématiques"}</h2>
          <p class="m-0 max-w-[46ch] text-ink-soft">{intro || "Des créations pour le quotidien comme pour vos plus belles occasions."}</p>
        </div>
        <a class="inline-flex min-h-11 items-center gap-2 text-xs font-semibold tracking-[0.14em] text-burgundy uppercase underline decoration-gold decoration-1 underline-offset-[0.5em] hover:text-rose-dusty" href="/boutique">Voir toute la boutique <span aria-hidden="true">→</span></a>
      </div>
      <!-- Cards stretch to the row height and pin the price row to the bottom, so prices line up whatever the name length. -->
      <ul class="m-0 grid list-none grid-cols-2 gap-3 p-0 md:grid-cols-4 md:gap-4 lg:gap-6">
        {products.map((p, i) => <li><ProductCard product={p} eager={i < 2} /></li>)}
      </ul>
    </div>
  </section>
)}

<script>
  // Colour previews: a swatch swaps the card photo (the link still opens the product).
  document.addEventListener("click", (e) => {
    const b = (e.target as Element).closest<HTMLButtonElement>("[data-swatch]");
    if (!b) return;
    const card = b.closest("[data-card]")!;
    const img = card.querySelector<HTMLImageElement>("[data-card-img]")!;
    img.removeAttribute("srcset");
    img.src = b.dataset.swatch!;
    card.querySelectorAll("[data-swatch]").forEach((s) => s.setAttribute("aria-pressed", String(s === b)));
  });
</script>
