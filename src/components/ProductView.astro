---
import Page from "../layouts/Page.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import ProductCard from "./ProductCard.astro";
import { discount, srcset, variant, tone } from "../data/products";
import type { Product } from "../data/products";
import { benefitIcon } from "../data/icons";
import { whatsappLink } from "../data/site";
import { fmtMad } from "../lib/offer";
import { breadcrumbLd, productLd } from "../data/seo";
import { loadStoreConfig, freeShippingText } from "../lib/store";
import { cmsEnabled, fetchReviews, type CmsReviews } from "../lib/cms";

interface Props { p: Product; products: Product[] }
const { p, products } = Astro.props;
const col = p.collection;
const colName = col === "bladi" ? "Collection Bladi" : "Collection Z’man";
const colPath = col === "bladi" ? "/collection-bladi" : "/collection-zman";
const paras = (t?: string) => (t ?? "").split(/\n{2,}/).map((x) => x.trim()).filter(Boolean);
// Intro: the CMS short description, else the first paragraph of the full one, else the photo's alt text. Nothing is invented.
const intro = (x: Product) => x.shortDescription?.trim() || paras(x.description)[0] || x.alt;
// Long description: only what goes beyond the intro (never repeated).
const longOf = (x: Product) => { const i = intro(x); const all = paras(x.description); return all.length && !(all.length === 1 && all[0] === i) && all.join("\n\n") !== i ? all : []; };
const metaSrc = p.shortDescription ?? p.description;
const description = metaSrc ? `${metaSrc.slice(0, 155)}${metaSrc.length > 155 ? "…" : ""}` : `${p.alt}. Inspiré du savoir-faire marocain, ${colName} Maison Sabra. ${p.price} MAD.`;
const crumbs: [string, string][] = [["Accueil", "/"], ["Boutique", "/boutique"], [colName, colPath], [p.name, `/produit/${p.slug}`]];
const config = await loadStoreConfig();
const waText = (name: string, price: number, variantName?: string) => `Bonjour, je souhaite commander : ${name}${variantName ? ` (${variantName})` : ""} (${price} MAD).`;
const wa = whatsappLink(waText(p.name, p.price), config.whatsapp);
// Approved reviews only (the CMS filters them). None, or CMS unreachable: nothing about reviews is shown.
const reviews: CmsReviews | null = cmsEnabled ? await fetchReviews(p.slug).catch(() => null) : null;
const saving = (x: Product) => (x.was && x.was > x.price ? x.was - x.price : 0);
const sellable = (x: Product) => x.purchasable !== false && !(x.variants?.length && x.variants.every((v) => !v.purchasable));

// Recommendations: the CMS's curated "related" first, then the same collection, then anything else; sellable pieces lead.
const bySlug = new Map(products.map((x) => [x.slug, x]));
const others = products.filter((x) => x.slug !== p.slug);
const pool = [...(p.related ?? []).map((s) => bySlug.get(s)).filter((x): x is Product => !!x && x.slug !== p.slug), ...others.filter((x) => x.collection === col), ...others];
const uniq = [...new Map(pool.map((x) => [x.slug, x])).values()];
const related = [...uniq.filter(sellable), ...uniq.filter((x) => !sellable(x))].slice(0, 4);

// Every sibling in the collection is a colourway of the same family: one JSON payload lets the page switch without a reload.
const family = products.filter((x) => x.collection === col);
const shortName = (x: Product) => { const s = x.slug.replace(/^(zman|bladi)-/, ""); return s.charAt(0).toUpperCase() + s.slice(1); };
const pic = (src: string) => ({ src, w480: variant(src, 480), w800: variant(src, 800) });
const data = family.map((x) => ({
  slug: x.slug, name: x.name, short: shortName(x), price: x.price, was: x.was ?? null, save: saving(x), pct: discount(x),
  alt: x.alt, copy: intro(x), long: longOf(x), specs: x.specs ?? [], care: x.care ?? null,
  imgs: (x.gallery?.length ? x.gallery : [x.img, x.img2].filter(Boolean) as string[]).map(pic),
  thumb: variant(x.img, 480),
  // Straight from the CMS: active benefits in their configured order, units left (only when low), availability, variants.
  perks: (x.benefits ?? []).map((b) => ({ title: b.title, text: b.text ?? null, icon: benefitIcon(b.icon) })),
  left: x.stock ?? null, buyable: x.purchasable !== false, promo: x.promoLabel ?? null,
  variants: (x.variants ?? []).map((v) => ({ name: v.name, color: v.color ?? null, price: v.price, was: v.was ?? null, img: v.img ? pic(v.img) : null, buyable: v.purchasable, left: v.left ?? null })),
}));
const cur = data.find((d) => d.slug === p.slug)!;
const slides = cur.imgs.map((i) => i.src);
// The first variant that can be bought is preselected, as on the client.
const v0 = cur.variants.find((v) => v.buyable) ?? cur.variants[0];
const left0 = (v0 ? v0.left : cur.left) ?? 0;
const buyable0 = v0 ? v0.buyable : cur.buyable;
const reviewLd = reviews && reviews.average != null && reviews.count > 0 ? { average: reviews.average, count: reviews.count } : null;

// Reassurance under the buy buttons: only what the store's CMS settings state. Nothing here is written by hand.
const reassure = [
  ...config.payments,
  ...(freeShippingText(config) ? [freeShippingText(config)!] : []),
  ...(config.deliveryDelay ? [`Livraison : ${config.deliveryDelay}`] : []),
  ...config.trust.map((t) => t.title),
].filter((t, i, a) => a.findIndex((x) => x.toLowerCase() === t.toLowerCase()) === i).slice(0, 4);

// "Livraison, paiement et retours": the same settings in full, plus the policy pages.
const policy: { lines: string[]; links: { label: string; href: string }[] } = {
  lines: [
    ...config.payments,
    ...(config.freeFrom != null ? [`Livraison gratuite dès ${config.freeFrom.toLocaleString("fr-FR")} MAD`] : []),
    ...(config.deliveryDelay ? [`Délai de livraison : ${config.deliveryDelay}`] : []),
    ...(config.returnsDays != null ? [`Retours possibles sous ${config.returnsDays} jour${config.returnsDays > 1 ? "s" : ""}`] : []),
    ...(config.returnsSummary ? [config.returnsSummary] : []),
  ],
  links: [
    ...(config.deliveryPolicyUrl ? [{ label: "Conditions de livraison", href: config.deliveryPolicyUrl }] : []),
    ...(config.returnsPolicyUrl ? [{ label: "Conditions de retour et d’échange", href: config.returnsPolicyUrl }] : []),
  ],
};
const hasPolicy = policy.lines.length > 0 || policy.links.length > 0;
const tick = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>`;
const chev = (d: string) => `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"/></svg>`;
const hasDetails = data.some((d) => d.long.length > 0 || d.specs.length > 0 || !!d.care || d.perks.length > 0);
---
<Page
  title={`${p.name} | Maison Sabra`}
  description={description}
  image={p.img}
  ogType="product"
  jsonLd={[breadcrumbLd(crumbs), productLd(p, description, colName, reviewLd, sellable(p))]}
  whatsappText={`Bonjour, je souhaite des informations sur : ${p.name}.`}
>
  <article class="bg-ivory pt-6 pb-24 min-[60rem]:pt-10 min-[60rem]:pb-28" data-pdp data-slug={p.slug} data-collection={col}>
    <div class="mx-auto max-w-(--max) px-(--gutter)">
      <Breadcrumbs crumbs={crumbs} />

      <div class="mt-6 grid gap-8 min-[60rem]:mt-8 min-[60rem]:grid-cols-[1.15fr_1fr] min-[60rem]:items-start min-[60rem]:gap-16">

        <!-- Gallery: one snap track for swipe and thumbnails alike. -->
        <div class:list={["-mx-(--gutter) min-[60rem]:mx-0", slides.length > 1 && "min-[60rem]:grid min-[60rem]:grid-cols-[4.5rem_1fr] min-[60rem]:gap-4"]} data-gallery>
          <ul class:list={["m-0 hidden list-none content-start gap-3 p-0", slides.length > 1 && "min-[60rem]:grid"]} data-thumbs aria-label="Vues du produit">
            {slides.length > 1 && slides.map((src, i) => (
              <li>
                <button type="button" class="block w-full cursor-pointer overflow-hidden border-0 p-0 ring-1 ring-burgundy/20 transition-shadow duration-300 aria-[current=true]:ring-[1.5px] aria-[current=true]:ring-burgundy aria-[current=true]:ring-offset-2 aria-[current=true]:ring-offset-ivory hover:ring-gold" style={`background:${tone()}`} data-thumb={i} aria-current={i === 0} aria-label={`Vue ${i + 1}`}>
                  <img class="aspect-square w-full object-cover mix-blend-multiply" src={variant(src, 480)} alt="" width="72" height="72" loading="lazy" decoding="async" />
                </button>
              </li>
            ))}
          </ul>

          <div class="relative min-w-0">
            <div class="flex snap-x snap-mandatory overflow-x-auto overscroll-x-contain scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden motion-reduce:scroll-auto" style={`background:${tone()}`} data-track tabindex="0" role="group" aria-roledescription="carrousel" aria-label="Photos du produit" data-lenis-prevent-touch>
              {slides.map((src, i) => (
                <div class="group/slide relative w-full shrink-0 snap-center overflow-hidden min-[60rem]:cursor-zoom-in" data-slide aria-roledescription="diapositive" aria-label={`${i + 1} sur ${slides.length}`}>
                  <img
                    class="aspect-[1000/988] w-full object-cover mix-blend-multiply transition-transform duration-500 ease-(--ease-out)"
                    src={i === 0 ? variant(src, 800) : variant(src, 480)}
                    srcset={i === 0 ? srcset(src) : `${variant(src, 480)} 480w, ${src} 800w`}
                    sizes="(min-width: 60rem) 48vw, 100vw"
                    alt={i === 0 ? p.alt : `${p.name}, vue ${i + 1}`}
                    width="1000" height="988"
                    loading={i === 0 ? "eager" : "lazy"}
                    fetchpriority={i === 0 ? "high" : undefined}
                    decoding="async"
                  />
                </div>
              ))}
            </div>
            <div class:list={["pointer-events-none absolute inset-y-0 right-0 left-0 hidden items-center justify-between px-3 min-[60rem]:flex", slides.length < 2 && "min-[60rem]:hidden"]} data-nav>
              <button type="button" class="pointer-events-auto grid size-11 cursor-pointer place-items-center rounded-full border-0 bg-white/85 text-burgundy transition-colors duration-300 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-burgundy disabled:opacity-0" data-prev aria-label="Photo précédente"><Fragment set:html={chev("M15 5l-7 7 7 7")} /></button>
              <button type="button" class="pointer-events-auto grid size-11 cursor-pointer place-items-center rounded-full border-0 bg-white/85 text-burgundy transition-colors duration-300 hover:bg-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-burgundy disabled:opacity-0" data-next aria-label="Photo suivante"><Fragment set:html={chev("M9 5l7 7-7 7")} /></button>
            </div>
            <p class="sr-only" role="status" data-gallery-status></p>
            <p class:list={["absolute right-3 bottom-3 m-0 bg-cream-soft/90 px-2.5 py-1 text-xs font-semibold tabular-nums tracking-[0.1em] text-burgundy", slides.length < 2 && "hidden"]} data-counter aria-hidden="true">1 / {slides.length}</p>
            <div class:list={["absolute inset-x-0 bottom-3 flex justify-center gap-2 min-[60rem]:hidden", slides.length < 2 && "hidden"]} data-dots aria-hidden="true">
              {slides.map((_, i) => <span class="size-1.5 rounded-full bg-burgundy/30 transition-[background-color,width] duration-300 data-[on=true]:w-5 data-[on=true]:bg-burgundy" data-dot data-on={i === 0}></span>)}
            </div>
          </div>
        </div>

        <!-- Buying column -->
        <div class="grid content-start gap-6 min-[60rem]:sticky min-[60rem]:top-28">
          <header class="grid gap-3">
            <p class="m-0 text-xs font-semibold tracking-[0.14em] text-ink-soft uppercase"><a class="text-ink-soft no-underline hover:text-burgundy" href={colPath}>{colName}</a>{p.isNew && <span class="text-rose-dusty"> · Nouveau</span>}</p>
            <h1 class="m-0 font-display text-[clamp(1.75rem,1.45rem+1.1vw,2.375rem)] leading-[1.1] text-balance text-burgundy-deep" data-title>{p.name}</h1>
            <!-- Rating summary: filled from approved CMS reviews only; hidden when there are none. -->
            <p class="m-0 hidden items-center gap-2 text-sm text-ink-soft" data-rating></p>
            <div class="grid gap-1.5">
              <p class="m-0 flex flex-wrap items-baseline gap-x-3 gap-y-1 tabular-nums">
                <span class="sr-only">Prix actuel :</span><span class="text-base leading-none font-normal text-burgundy" data-price-now>{fmtMad(p.price)}</span>
                <s class:list={["text-base text-ink-soft", !discount(p) && "hidden"]} data-was><span class="sr-only">Prix initial :</span>{fmtMad(p.was ?? 0)}</s>
              </p>
              <p class:list={["m-0 text-sm font-semibold text-rose-dusty tabular-nums", !saving(p) && "hidden"]} data-save>Vous économisez {fmtMad(saving(p))} (−{discount(p)} %)</p>
            </div>
          </header>

          <p class="m-0 max-w-[52ch] whitespace-pre-line text-ink-soft" data-copy>{cur.copy}</p>

          {family.length > 1 && (
            <fieldset class="m-0 grid min-w-0 gap-3 border-0 p-0">
              <legend class="mb-3 flex w-full items-baseline justify-between gap-3 p-0 text-sm text-ink-soft">
                <span class="font-semibold tracking-[0.08em] text-burgundy-deep uppercase">{col === "bladi" ? "Modèle" : "Coloris"}</span>
                <span class="text-ink" data-variant-name>{shortName(p)}</span>
              </legend>
              <div class="-m-1 flex gap-3 overflow-x-auto p-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-variants>
                {family.map((x) => (
                  <label class="group/v relative block w-[4.5rem] shrink-0 cursor-pointer min-[60rem]:w-20">
                    <input class="peer sr-only" type="radio" name="variant" value={x.slug} checked={x.slug === p.slug} />
                    <span class="block overflow-hidden rounded-md ring-1 ring-gold/40 transition-shadow duration-300 group-hover/v:ring-gold peer-checked:ring-[1.5px] peer-checked:ring-burgundy peer-checked:ring-offset-2 peer-checked:ring-offset-ivory peer-focus-visible:outline-2 peer-focus-visible:outline-offset-3 peer-focus-visible:outline-burgundy" style={`background:${tone()}`}>
                      <img class="aspect-square w-full object-cover mix-blend-multiply" src={variant(x.img, 480)} alt="" width="80" height="80" loading="lazy" decoding="async" />
                    </span>
                    <span class="mt-1.5 block truncate text-center text-xs text-ink-soft peer-checked:font-semibold peer-checked:text-burgundy">{shortName(x)}</span>
                    <span class="absolute top-1 right-1 grid size-5 scale-50 place-items-center rounded-full bg-burgundy text-cream-soft opacity-0 transition-[opacity,scale] duration-300 ease-(--ease-out) peer-checked:scale-100 peer-checked:opacity-100"><Fragment set:html={tick} /></span>
                  </label>
                ))}
              </div>
            </fieldset>
          )}

          <!-- CMS variants (colour, size…) of this product: own photo, price and stock. Built by the page script. -->
          <fieldset class="m-0 hidden min-w-0 gap-3 border-0 p-0" data-cms-variants>
            <legend class="mb-3 flex w-full items-baseline justify-between gap-3 p-0 text-sm text-ink-soft">
              <span class="font-semibold tracking-[0.08em] text-burgundy-deep uppercase">Coloris</span>
              <span class="text-ink" data-cms-variant-name></span>
            </legend>
            <div class="flex flex-wrap gap-3" data-cms-variant-list></div>
          </fieldset>

          <!-- Availability: from the selected variant's real CMS stock. Low stock only at or under the CMS threshold. -->
          <p class:list={["m-0 flex items-center gap-2.5 text-sm font-semibold text-rose-dusty", !(buyable0 && left0 > 0) && "hidden"]} data-stock role="status">
            <span class="size-2 shrink-0 rounded-full bg-gold"></span><span data-stock-text>{buyable0 && left0 > 0 ? `Plus que ${left0} ${left0 > 1 ? "pièces disponibles" : "pièce disponible"}` : ""}</span>
          </p>
          <p class:list={["m-0 flex items-center gap-2.5 text-sm font-semibold text-burgundy-deep", buyable0 && "hidden"]} data-soldout role="status">
            <span class="size-2 shrink-0 rounded-full bg-burgundy-deep"></span>Momentanément indisponible
          </p>

          <!-- Two-bag offer: revealed only once the server confirms the code covers this bag. -->
          <fieldset class="m-0 hidden min-w-0 gap-3 border-0 p-0" data-offer>
            <legend class="mb-3 p-0 text-sm font-semibold tracking-[0.08em] text-burgundy-deep uppercase" data-offer-legend>Votre sélection</legend>
            <p class="m-0 hidden text-sm text-ink" data-offer-note></p>
            <div class="grid grid-cols-2 gap-3" data-offer-choices>
              <label class="block cursor-pointer">
                <input class="peer sr-only" type="radio" name="qty" value="1" checked />
                <span class="grid h-full content-start gap-1 bg-white/60 p-3.5 ring-1 ring-burgundy/25 transition-[box-shadow,background-color] duration-300 peer-checked:bg-white peer-checked:ring-[1.5px] peer-checked:ring-burgundy peer-checked:ring-offset-2 peer-checked:ring-offset-ivory peer-focus-visible:outline-2 peer-focus-visible:outline-offset-3 peer-focus-visible:outline-burgundy">
                  <span class="text-sm font-semibold text-burgundy-deep">Un sac</span>
                  <span class="text-sm text-ink tabular-nums" data-one-total>{fmtMad(p.price)}</span>
                  <span class="text-xs leading-snug text-ink-soft" data-one-hint></span>
                </span>
              </label>
              <label class="block cursor-pointer">
                <input class="peer sr-only" type="radio" name="qty" value="2" />
                <span class="grid h-full content-start gap-1 bg-white/60 p-3.5 ring-1 ring-burgundy/25 transition-[box-shadow,background-color] duration-300 peer-checked:bg-white peer-checked:ring-[1.5px] peer-checked:ring-burgundy peer-checked:ring-offset-2 peer-checked:ring-offset-ivory peer-focus-visible:outline-2 peer-focus-visible:outline-offset-3 peer-focus-visible:outline-burgundy">
                  <span class="text-sm font-semibold text-burgundy-deep">Deux sacs <span class="text-rose-dusty" data-two-pct></span></span>
                  <span class="text-sm text-ink tabular-nums" data-two-total></span>
                  <span class="text-xs leading-snug font-semibold text-rose-dusty tabular-nums" data-two-save></span>
                </span>
              </label>
            </div>

            <div class="hidden gap-3 pt-2" data-second>
              <p class="m-0 flex items-baseline justify-between gap-3 text-sm text-ink-soft"><span class="font-semibold text-burgundy-deep">Votre deuxième sac</span><span class="text-ink" data-second-name></span></p>
              <div class="-m-1 flex gap-3 overflow-x-auto p-1 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" data-second-list role="radiogroup" aria-label="Deuxième sac"></div>
            </div>
          </fieldset>

          <div class="grid gap-3" data-buy-area>
            <p class="m-0 hidden items-baseline justify-between gap-3 tabular-nums" aria-live="polite" data-total-row>
              <span class="text-sm text-ink-soft" data-total-label>Total</span>
              <span class="text-step-1 font-semibold text-burgundy" data-total>{fmtMad(p.price)}</span>
            </p>
            <button class="btn min-h-14 w-full disabled:cursor-not-allowed disabled:opacity-55 aria-busy:cursor-wait" type="button" data-pdp-buy data-primary-cta>Commander maintenant</button>
            <button class="inline-flex min-h-12 w-full cursor-pointer items-center justify-center gap-2 border border-burgundy/60 bg-transparent px-7 text-xs leading-none font-semibold tracking-[0.16em] text-burgundy uppercase transition-colors duration-300 hover:bg-burgundy hover:text-cream-soft focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-burgundy disabled:cursor-not-allowed disabled:opacity-55 aria-busy:cursor-wait" type="button" data-pdp-add>Ajouter au panier</button>
            <p class="sr-only" role="status" data-announce></p>
            {wa && <a class="mt-1 inline-flex min-h-11 items-center justify-center gap-2 text-sm text-ink-soft no-underline hover:text-burgundy focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-burgundy" href={wa} target="_blank" rel="noopener" data-wa data-number={config.whatsapp ?? ""}>Une question ? <span class="font-semibold text-burgundy underline decoration-gold decoration-1 underline-offset-[0.4em]">Commander par WhatsApp</span></a>}
          </div>

          {reassure.length > 0 && (
            <ul class="m-0 grid list-none gap-2 border-t border-gold/40 p-0 pt-4 text-[0.8125rem] leading-snug text-ink-soft min-[30rem]:grid-cols-2" aria-label="Livraison et paiement">
              {reassure.map((t) => <li class="flex items-start gap-2.5"><span class="mt-px shrink-0 text-burgundy [&_svg]:block"><Fragment set:html={tick} /></span>{t}</li>)}
            </ul>
          )}
        </div>
      </div>

      {hasDetails && (
        <section class="mt-16 grid gap-10 min-[48rem]:mt-24 min-[60rem]:grid-cols-[1.15fr_1fr] min-[60rem]:gap-16" aria-labelledby="details-title" data-details>
          <div class="grid content-start gap-8">
            <h2 id="details-title" class="m-0 text-step-2">Le sac</h2>
            <div class="grid max-w-[60ch] gap-4 text-ink-soft empty:hidden" data-long>
              {cur.long.map((t) => <p class="m-0 whitespace-pre-line">{t}</p>)}
            </div>
            <!-- Benefits: the product's own active CMS benefits, in order. None: no list. -->
            <ul class:list={["m-0 grid max-w-[60ch] list-none gap-3.5 p-0 text-[0.9375rem] leading-snug text-ink", !cur.perks.length && "hidden"]} data-perks aria-label="Atouts du produit">
              {cur.perks.map((b) => (
                <li class="flex items-start gap-3"><span class="mt-px shrink-0 text-burgundy [&_svg]:block"><Fragment set:html={b.icon} /></span><span><span class="font-semibold">{b.title}</span>{b.text && <span class="text-ink-soft"> : {b.text}</span>}</span></li>
              ))}
            </ul>
          </div>
          <!-- Specifications: rendered only for fields the CMS holds (dimensions, materials, closure, strap, care…). -->
          <div class:list={["grid content-start gap-4", !(cur.specs.length || cur.care) && "hidden"]} data-specs-wrap>
            <h3 class="m-0 font-display text-step-1 leading-tight">Dimensions et détails</h3>
            <dl class="m-0 grid border-t border-gold/40" data-specs>
              {cur.specs.map((r) => <div class="grid grid-cols-[minmax(0,2fr)_minmax(0,3fr)] gap-4 border-b border-gold/40 py-3 text-sm"><dt class="text-ink-soft">{r.label}</dt><dd class="m-0 text-ink">{r.value}</dd></div>)}
              {cur.care && <div class="grid grid-cols-[minmax(0,2fr)_minmax(0,3fr)] gap-4 border-b border-gold/40 py-3 text-sm"><dt class="text-ink-soft">Entretien</dt><dd class="m-0 text-ink">{cur.care}</dd></div>}
            </dl>
          </div>
        </section>
      )}

      {hasPolicy && (
        <section class="mt-14 max-w-3xl min-[48rem]:mt-20" aria-labelledby="policy-title">
          <h2 id="policy-title" class="mb-4 text-step-1">Livraison, paiement et retours</h2>
          <details class="group border-y border-gold/40">
            <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 text-sm font-semibold tracking-[0.08em] text-burgundy-deep uppercase focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-burgundy [&::-webkit-details-marker]:hidden"><span>Comment ça se passe</span><span class="text-xl leading-none text-gold transition-transform duration-300 group-open:rotate-45 motion-reduce:transition-none" aria-hidden="true">+</span></summary>
            <div class="grid gap-3 pb-6 text-ink-soft">
              {policy.lines.map((t) => <p class="m-0 max-w-[60ch]">{t}</p>)}
              {policy.links.map((l) => <a class="w-fit text-sm font-semibold text-burgundy underline decoration-gold underline-offset-4 hover:text-rose-dusty" href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
            </div>
          </details>
        </section>
      )}

      <!-- Brand note: one short paragraph, the same words the home page uses. -->
      <section class="mt-14 max-w-3xl min-[48rem]:mt-20" aria-labelledby="maison-title">
        <h2 id="maison-title" class="mb-3 text-step-1">Maison Sabra</h2>
        <p class="m-0 max-w-[60ch] text-ink-soft">Maison Sabra fait vivre l’héritage artisanal marocain à travers des sacs pensés pour la femme d’aujourd’hui. Velours brodé, dorures, cuir et tissu berbère : chaque pièce est façonnée à la main, avec le soin du détail qui fait la différence.</p>
        <a class="mt-3 inline-flex min-h-11 items-center text-sm font-semibold text-burgundy underline decoration-gold underline-offset-4 hover:text-rose-dusty" href="/#maison">Découvrir notre histoire</a>
      </section>

      <!-- Customer reviews: approved CMS reviews only; the section stays hidden until there is at least one. -->
      <section class="mt-20 hidden min-[48rem]:mt-28" aria-labelledby="reviews-title" data-reviews>
        <h2 id="reviews-title" class="mb-3 text-step-2">Avis de nos clientes</h2>
        <p class="mb-8 text-ink-soft" data-reviews-summary></p>
        <ul class="m-0 grid list-none gap-6 p-0 min-[48rem]:grid-cols-2 min-[60rem]:grid-cols-3" data-reviews-list></ul>
      </section>

      {related.length > 0 && (
        <section class="mt-20 min-[48rem]:mt-28" aria-labelledby="related-title">
          <h2 id="related-title" class="mb-10 text-step-2">Vous aimerez aussi</h2>
          <div class="grid grid-cols-2 gap-x-4 gap-y-10 min-[60rem]:grid-cols-4 min-[60rem]:gap-x-6">
            {related.map((r, i) => <div class:list={[related.length % 2 === 1 && i === related.length - 1 && "max-[59.99rem]:hidden"]}><ProductCard product={r} /></div>)}
          </div>
        </section>
      )}
    </div>

    <!-- Sticky purchase bar: mobile only, appears once the main button has scrolled away. -->
    <div class="fixed inset-x-0 bottom-0 z-40 translate-y-full border-t border-gold/50 bg-cream-soft/97 px-(--gutter) pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] shadow-[0_-10px_24px_-12px_rgb(74_15_34/0.3)] transition-transform duration-500 ease-(--ease-out) data-[show=true]:translate-y-0 min-[60rem]:hidden" data-sticky data-show="false" inert>
      <div class="flex items-center gap-4">
        <p class="m-0 grid min-w-0 leading-tight tabular-nums"><span class="truncate text-xs text-ink-soft" data-sticky-name>{v0 ? `${cur.short} · ${v0.name}` : p.name}</span><span class="text-lg font-semibold text-burgundy" data-total-mirror>{fmtMad(p.price)}</span></p>
        <button class="btn ml-auto min-h-12 shrink-0 px-5" type="button" data-pdp-buy>Commander</button>
      </div>
    </div>

    <script type="application/json" id="pdp-data" set:html={JSON.stringify({ family: data, reviews: { [p.slug]: reviews } }).replace(/</g, "\\u003c")} />
  </article>
</Page>

<style is:global>
  /* The sticky bar owns the bottom edge on phones: park the floating shortcuts while it is up. */
  @media (max-width: 59.99rem) {
    body:has([data-sticky][data-show="true"]) [data-floating-cart],
    body:has([data-sticky][data-show="true"]) a[href^="https://wa.me"] { opacity: 0; pointer-events: none; }
  }
</style>

<script>
  import "../scripts/pdp";
</script>
