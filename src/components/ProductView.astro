---
import Page from "../layouts/Page.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import CatalogCard from "./CatalogCard.astro";
import ProductSupport from "./ProductSupport.astro";
import { discount, srcset, variant } from "../data/products";
import type { Product } from "../data/products";
import { site, whatsappLink } from "../data/site";
import { breadcrumbLd, productLd } from "../data/seo";

interface Props { p: Product; products: Product[] }
const { p, products } = Astro.props;
const col = p.collection;
const colName = col === "bladi" ? "Collection Bladi" : "Collection Z’man";
const colPath = col === "bladi" ? "/collection-bladi" : "/collection-zman";
const material = col === "bladi" ? "cuir et tissu berbère" : "velours et dorures";
const description = p.description ? `${p.description.slice(0, 150)}${p.description.length > 150 ? "…" : ""}` : `${p.alt}. Fait main au Maroc, ${colName} Maison Sabra. ${p.price} dhs.`;
const crumbs: [string, string][] = [["Accueil", "/"], ["Boutique", "/boutique"], [colName, colPath], [p.name, `/produit/${p.slug}`]];
const related = products.filter((x) => x.collection === col && x.slug !== p.slug).slice(0, 3);
const wa = whatsappLink(`Bonjour, je souhaite commander : ${p.name} (${p.price} dhs).`);
const sizes = "(min-width: 60rem) 40vw, 100vw";
const colorNames: Record<string, string> = { "zman-multicolore": "Multicolore", "zman-rouge": "Rouge", "zman-vert": "Vert", "zman-beige": "Beige doré", "zman-violet": "Violet" };
const gallery = [p.img, p.img2].filter(Boolean) as string[];
---
<Page
  title={`${p.name} | Maison Sabra`}
  description={description}
  image={p.img}
  ogType="product"
  jsonLd={[breadcrumbLd(crumbs), productLd(p, description, colName)]}
  whatsappText={`Bonjour, je souhaite des informations sur : ${p.name}.`}
>
  <article class="bg-cream-soft pt-8 pb-20 min-[48rem]:pt-10 min-[48rem]:pb-28">
    <div class="mx-auto max-w-(--max) px-(--gutter)">
      <Breadcrumbs crumbs={crumbs} />

      <div class="mt-8 grid gap-10 min-[60rem]:grid-cols-[1fr_1.15fr] min-[60rem]:items-start min-[60rem]:gap-10">
        <div class="grid gap-4 lg:sticky lg:top-24">
          <img data-gallery-main class="aspect-[3/2] w-full rounded-lg bg-white object-contain" src={p.img} alt={p.alt} width="1000" height="988" loading="eager" fetchpriority="high" />
          <div class="grid grid-cols-4 gap-3" role="group" aria-label="Vues du produit">
            {gallery.map((src, i) => <button type="button" data-gallery-src={src} aria-label={`Voir la photo ${i + 1} : ${p.name}`} aria-pressed={i === 0 ? 'true' : 'false'} class="aspect-square w-full cursor-pointer overflow-hidden rounded border border-gold/25 bg-white p-1 aria-pressed:border-burgundy focus-visible:outline-2 focus-visible:outline-burgundy"><img class="size-full object-contain" src={src} alt="" width="100" height="100" loading="lazy" /></button>)}
          </div>
          <p class="rounded bg-white p-4 text-xs font-medium text-burgundy">Façonné à la main au Maroc · Savoir-faire artisanal</p>
        </div>

        <div class="grid content-start gap-6">
          <header class="grid gap-4">
            <p class="m-0 text-[.625rem] font-semibold tracking-[0.1em] text-rose-dusty uppercase"><a class="text-ink-soft no-underline hover:text-burgundy" href={colPath}>{colName}</a></p>
            <h1 class="text-step-2">{p.name}</h1>
          </header>
          <p class="m-0 max-w-[52ch] whitespace-pre-line text-sm leading-relaxed text-ink-soft">{p.description ?? `${p.alt}. Un sac artisanal en ${material}, fait main au Maroc.`}</p>
          <div class="grid gap-4 rounded-lg bg-white p-5">
            <div class="flex flex-wrap items-baseline gap-x-5 gap-y-3 tabular-nums">
              <p class="m-0 m-0 inline-flex items-baseline gap-2 whitespace-nowrap font-display text-4xl font-semibold leading-none text-burgundy">{p.price}<span class="text-xl">MAD</span></p>
              {discount(p) > 0 && <><s class="whitespace-nowrap text-sm text-ink-soft">{p.was} MAD</s><span class="ml-auto self-center rounded-lg bg-burgundy px-3 py-2 text-[.625rem] font-bold uppercase tracking-wider text-white">Économisez {p.was! - p.price} MAD (−{discount(p)} %)</span></>}
            </div>
            <p class="m-0 border-t border-gold/20 pt-3 text-[.6875rem] leading-relaxed text-ink-soft">Livraison au Maroc · Offerte dès {site.freeShippingFrom} dhs</p>
          </div>
          <div>
            <p class="mb-3 text-[.625rem] font-semibold uppercase tracking-wider text-ink-soft">Modèle sélectionné : <span class="font-display text-sm normal-case text-burgundy">{colorNames[p.slug] ?? p.name}</span></p>
            <div class="grid grid-cols-5 gap-2">
              {products.filter((item) => item.collection === col).map((item) => <a href={`/produit/${item.slug}`} aria-current={item.slug === p.slug ? 'page' : undefined} class="flex min-h-20 flex-col items-center justify-center overflow-hidden rounded border border-gold/25 bg-white p-1 no-underline aria-[current=page]:border-burgundy focus-visible:outline-2 focus-visible:outline-burgundy"><img class="size-9 object-contain" src={item.img} alt="" width="64" height="64" loading="lazy" /><span class="mt-1 text-center text-[.5625rem] leading-snug text-ink">{colorNames[item.slug] ?? item.name}</span></a>)}
            </div>
          </div>
          <form data-express-order data-slug={p.slug} class="grid gap-4 rounded-lg bg-card-beige p-5 md:p-6">
            <h2 class="font-body text-xs font-bold uppercase tracking-wider">Commande express</h2>
            <div class="grid gap-3 sm:grid-cols-2">
              {[['firstName', 'Prénom', 'given-name'], ['lastName', 'Nom', 'family-name'], ['phone', 'Téléphone', 'tel'], ['city', 'Ville de livraison', 'address-level2'], ['address', 'Adresse et quartier', 'street-address']].map(([name, label, autocomplete]) => <label class:list={["grid gap-2 text-[.625rem] font-semibold uppercase tracking-wider text-ink-soft", name === 'address' && 'sm:col-span-2']}>{label}<input class="min-h-11 min-w-0 border border-gold/25 bg-white px-3 text-sm font-normal normal-case tracking-normal text-ink focus-visible:outline-2 focus-visible:outline-burgundy" name={name} autocomplete={autocomplete} type={name === 'phone' ? 'tel' : 'text'} required minlength={name === 'phone' ? 10 : 2} maxlength="300" /></label>)}
            </div>
            <p class="rounded bg-white p-3 text-xs font-semibold tracking-wide text-burgundy">Paiement cash à la livraison</p>
            <button type="submit" class="min-h-12 cursor-pointer border-0 bg-burgundy px-4 py-3 text-xs font-semibold uppercase tracking-wider text-white hover:bg-burgundy-deep focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-burgundy disabled:opacity-60">Commander maintenant · {p.price} MAD</button>
            <p data-express-status role="status" class="text-xs leading-relaxed text-burgundy"></p>
          </form>
          <button class="min-h-11 cursor-pointer border-0 bg-transparent text-xs font-semibold text-burgundy underline decoration-gold underline-offset-4 focus-visible:outline-2 focus-visible:outline-burgundy" type="button" data-add={p.slug} data-name={p.name} data-price={p.price} data-img={variant(p.img, 480)}>Ajouter au panier</button>
          {wa && <a class="text-sm font-semibold tracking-[0.08em] text-burgundy uppercase underline decoration-gold decoration-1 underline-offset-8 hover:text-rose-dusty" href={wa} target="_blank" rel="noopener">Commander par WhatsApp</a>}

          <ul class="m-0 grid grid-cols-3 list-none gap-3 p-0 text-center text-[.625rem] font-medium leading-relaxed text-burgundy [&_li]:rounded [&_li]:bg-white [&_li]:p-3">
            <li>100 % fait au Maroc</li>
            <li>Livraison gratuite dès {site.freeShippingFrom.toLocaleString("fr-FR")} dhs</li>
            <li>Emballage cadeau possible</li>
          </ul>
        </div>
      </div>

      <section class="mt-24 min-[48rem]:mt-32" aria-labelledby="related-title">
        <h2 id="related-title" class="mb-10 text-step-2">Vous aimerez aussi</h2>
        <div class="grid grid-cols-1 gap-5 min-[480px]:grid-cols-2 lg:grid-cols-3">
          {related.map((r, i) => <div class="min-w-0"><CatalogCard product={r} /></div>)}
        </div>
      </section>
    </div>
  </article>
  <ProductSupport />
</Page>

<script>
  import { crmReady, crmPost } from '../lib/crm';
  document.querySelectorAll<HTMLButtonElement>('[data-gallery-src]').forEach((button) => button.addEventListener('click', () => {
    const image = document.querySelector<HTMLImageElement>('[data-gallery-main]');
    if (image && button.dataset.gallerySrc) image.src = button.dataset.gallerySrc;
    document.querySelectorAll('[data-gallery-src]').forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
  }));
  const form = document.querySelector<HTMLFormElement>('[data-express-order]');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const status = form.querySelector<HTMLElement>('[data-express-status]')!;
    const button = form.querySelector<HTMLButtonElement>('[type=submit]')!;
    if (!crmReady) { status.textContent = 'La commande en ligne est momentanément indisponible. Veuillez réessayer plus tard.'; return; }
    button.disabled = true;
    status.textContent = 'Envoi en cours…';
    try {
      const fields = Object.fromEntries(new FormData(form).entries());
      const response = await crmPost('/orders', { ...fields, items: [{ slug: form.dataset.slug, qty: 1 }], source: 'store', attribution: { landingPage: location.pathname } });
      if (!response.ok) throw new Error('order');
      const result = await response.json();
      location.assign(`/commande/merci?n=${encodeURIComponent(result.order_number)}`);
    } catch { status.textContent = 'Votre commande n’a pas pu être envoyée. Vérifiez votre connexion puis réessayez.'; button.disabled = false; }
  });
</script>
