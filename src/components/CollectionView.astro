---
import FeaturedProducts from "./FeaturedProducts.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import type { Product } from "../data/products";
interface Props {
  title: string;
  intro: string;
  products: Product[];
  crumbs: [string, string][];
  others: { href: string; label: string }[];
}
const { title, intro, products, crumbs, others } = Astro.props;
---
<div class="bg-white pt-8 md:pt-10">
  <div class="mx-auto max-w-(--max) px-(--gutter)">
    <Breadcrumbs crumbs={crumbs} />
  </div>
  <FeaturedProducts products={products} title={title} intro={intro} page showFilters={Astro.url.pathname.replace(/\/$/, "") === "/boutique"} />
  <nav class="mx-auto flex max-w-(--max) flex-wrap items-center gap-6 border-t border-gold/25 px-(--gutter) py-8" aria-label="Autres collections">
    <p class="m-0 font-display text-xl text-burgundy">À découvrir aussi</p>
    {others.map((o) => <a class="inline-flex min-h-11 items-center text-xs font-semibold tracking-[.08em] text-burgundy uppercase underline decoration-gold underline-offset-8 hover:text-rose-dusty focus-visible:outline-2 focus-visible:outline-burgundy" href={o.href}>{o.label}</a>)}
  </nav>
</div>
