---
import "@fontsource-variable/montserrat/index.css";
import "@fontsource-variable/inter/wght.css";
import "@fontsource-variable/playfair-display/wght.css";
import "@fontsource-variable/playfair-display/wght-italic.css";
import "../styles/global.css";
import { config as C } from "../data/config.js";
import { productJsonLd } from "../lib/copy.js";

const { initial, productRoute } = Astro.props;
const title = productRoute ? initial.name + " | Maison Sabra" : "Sac Z’man — Velours Royal & Broderies Dorées | Maison Sabra";
const description = "Sac Z’man brodé à Casablanca, livré dans son écrin satin. Livraison offerte au Maroc. Vous inspectez votre sac avant de payer à la réception.";
const ogImage = new URL(initial.images[0].src, Astro.site ?? Astro.url).href;
const wa = `https://wa.me/${C.contact.whatsappNumber}`;
const jsonLd = productJsonLd(Astro.site ?? Astro.url);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#6e1e3a" />
    <link rel="canonical" href={productRoute ? new URL(Astro.url.pathname, Astro.site ?? Astro.url).href : C.seo.canonical} id="canonical" />
    <meta property="og:type" content="product.group" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Maison Sabra" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1012" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" as="image" href={initial.images[0].src} fetchpriority="high" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="icon" href="/zmancollection/lp/assets/logo-ms.webp" type="image/webp" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <slot />
    <!-- Filet de sécurité : si le script de la page n'a pas démarré (bloqueur de contenu, réseau…), le formulaire l'explique au lieu de se recharger sans rien dire. -->
    <script is:inline define:vars={{ wa, tel: C.contact.phoneTel, phone: C.contact.phoneDisplay }}>
      window.zmanFormFallback = function () {
        if (window.__zmanReady) return false;
        var a = document.getElementById("form-alert");
        if (a) {
          a.innerHTML = "<strong>Le formulaire n’a pas pu se charger correctement.</strong> Un bloqueur de publicités ou de contenu l’empêche peut-être de fonctionner : désactivez-le pour ce site puis rechargez la page, ou commandez par <a href=\"" + wa + "\" rel=\"noopener\">WhatsApp</a> · <a href=\"tel:" + tel + "\">" + phone + "</a>.";
          a.hidden = false; a.focus();
        }
        return false;
      };
    </script>
  </body>
</html>
