---
import "../styles/global.css";
import { config as C } from "../data/config.js";
import { productJsonLd } from "../lib/copy.js";

const title = "Sac Z’man – Sac de soirée marocain en velours brodé doré | Maison Sabra";
const description = "Collection Z’man par Maison Sabra : sacs artisanaux marocains en velours et tissu doré, chaîne dorée détachable. 549 MAD, livraison gratuite au Maroc, paiement à la livraison.";
const ogImage = "https://maisonsabra.ma/wp-content/uploads/2025/07/083A5723ms-rouge-_ms.jpg";
const wa = `https://wa.me/${C.contact.whatsappNumber}`;
const jsonLd = productJsonLd(Astro.site ?? Astro.url);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#6e1e3a" />
    <link rel="canonical" href={C.seo.canonical} id="canonical" />
    <meta property="og:type" content="product.group" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Maison Sabra" />
    <meta property="og:title" content="Collection Z’man — L’élégance marocaine, dans chaque détail | Maison Sabra" />
    <meta property="og:description" content="Velours, dorures et chaîne dorée détachable. 549 MAD · Livraison gratuite au Maroc · Paiement à la livraison." />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1012" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" as="image" href="/zmancollection/lp/assets/products/rouge-1.webp" fetchpriority="high" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" href="/zmancollection/lp/assets/logo-ms.webp" type="image/webp" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>
  <body>
    <slot />
    <!-- Filet de sécurité : si le script de la page n'a pas démarré (bloqueur de contenu, réseau…), le formulaire l'explique au lieu de se recharger sans rien dire. -->
    <script is:inline define:vars={{ wa, tel: C.contact.phoneTel, phone: C.contact.phoneDisplay }}>
      window.zmanFormFallback = function () {
        if (window.__zmanReady) return false;
        var a = document.getElementById("form-alert");
        if (a) {
          a.innerHTML = "<strong>Le formulaire n’a pas pu se charger correctement.</strong> Un bloqueur de publicités ou de contenu l’empêche peut-être de fonctionner : désactivez-le pour ce site puis rechargez la page, ou commandez par <a href=\"" + wa + "\" rel=\"noopener\">WhatsApp</a> · <a href=\"tel:" + tel + "\">" + phone + "</a>.";
          a.hidden = false; a.focus();
        }
        return false;
      };
    </script>
  </body>
</html>
