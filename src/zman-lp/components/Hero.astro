---

import { money } from "../lib/copy.js";
import { ShieldCheck, Truck, RefreshCcw, MessageCircle } from "lucide-static";
const { initial, models: P } = Astro.props;
const first = initial.images[0];
const quotes = [
  { name: "Salma R.", quote: "Maison Sabra, c’est bien plus qu’un sac… c’est une œuvre d’art. La finition est impeccable, et on sent le travail fait main derrière chaque détail." },
  { name: "Karima", quote: "J’ai été touchée par l’authenticité des produits. Il allie tradition et élégance avec une touche marocaine que j’adore. Je recommande à 100 %." },
  { name: "@eddahabitouria", quote: "أحييك مدام بهيجة على ابتكاراتك الرائعة، كل عروضك كانت تعبر عن اللمسة المغربية مزيد من التألق", arabic: true },
];
const stars = "★★★★★";
const [h1a, ...h1rest] = initial.name.split(/\s+[–-]\s+/);
const h1b = h1rest.join(" – ");
---
<section class="hero" id="hero" data-model={initial.id} aria-labelledby="h1">
      <div class="hero-gallery" aria-label="Galerie photo du modèle sélectionné">
        <div class="g-main">
          <span class="best-badge">{initial.collection === "bladi" ? "Fait main au Maroc" : "Atelier de Casablanca"}</span>
          <div class="g-track" id="g-track" tabindex="0" aria-roledescription="carrousel" aria-label="Photos du sac" role="group"><div class="g-slide"><img src={first.src} alt={first.alt} width={first.w} height={first.h} fetchpriority="high" /></div></div>
          <button class="g-nav g-prev" id="g-prev" type="button" aria-label="Photo précédente">‹</button>
          <button class="g-nav g-next" id="g-next" type="button" aria-label="Photo suivante">›</button>
          <div class="g-count" id="g-count" aria-live="polite"></div>
        </div>

        <div class="g-thumbs" id="g-thumbs" role="group" aria-label="Photos du modèle sélectionné">{initial.images.map((im,i)=><button type="button" class="g-thumb" data-i={i} aria-label={`Voir la photo ${i+1}`} aria-current={i===0 ? "true" : "false"}><img src={im.src} alt="" width="64" height="64" loading="lazy"/></button>)}</div>
      </div>

      <div class="hero-panel">
        <a id="rating-link" class="rating-link" href="#avis" hidden></a>
        <p class="rating-fallback" id="rating-fallback"><span class="rl-stars" aria-hidden="true">{stars}</span> {quotes.length} témoignages de clientes</p>
        <p class="eyebrow">{initial.collection === "bladi" ? "Collection Bladi · Fait main au Maroc" : "Édition Prestige · Brodé main à Casablanca"}</p>
        <h1 id="h1"><span id="h1-main">{h1a}</span> <em id="h1-sub">{h1b}</em></h1>
        
        <div class="price-box">
        <p class="price-row"><strong class="price" id="p-price">{money(initial.price)}</strong><s id="p-ref" hidden={!(initial.referencePrice > initial.price)}>{money(initial.referencePrice)}</s><span id="discount" hidden={!(initial.referencePrice > initial.price)}>−{Math.round(100*(1-initial.price/initial.referencePrice))} %</span></p>
        <p class="saving" id="saving" hidden={!(initial.referencePrice > initial.price)}>Vous économisez <strong id="saving-amount">{money(initial.referencePrice - initial.price)}</strong></p>
        </div>
        <p class="assurance">Livraison gratuite · Payez à la réception, après inspection</p>
        <p class="lede" id="lede" hidden={!(initial.tagline || initial.officialDescription)}>{initial.officialDescription || initial.tagline}</p>
        <fieldset class="swatches">
          <legend>Choisir le {initial.collection === "bladi" ? "modèle" : "coloris"} : <strong id="swatch-current"></strong></legend>
          <div class="swatch-list" id="swatch-list">
            {P.map((p) => (
              <div class="sw" data-out={p.stockStatus === "out_of_stock"}>
                <input type="radio" name="swatch" id={`sw-${p.id}`} value={p.id} aria-label={p.name} />
                <label for={`sw-${p.id}`}><img src={p.thumb} alt="" width="80" height="80" loading="lazy" /><span>{p.colorLabel}</span></label>
              </div>
            ))}
          </div>
        </fieldset>
        <ul class="benefits" id="benefits" hidden={!initial.benefits.length}>{initial.benefits.map((b)=><li><span><strong>{b.title}</strong>{b.description ? <span class="b-desc">{b.description}</span> : null}</span></li>)}</ul>
        <div class="tcar" aria-roledescription="carrousel" aria-label="Témoignages clientes">
          <ul class="tcar-track" id="tcar-track" tabindex="0">
            {quotes.map((q)=><li><figure><span class="rl-stars" aria-hidden="true">{stars}</span><blockquote lang={q.arabic?"ar":"fr"} dir={q.arabic?"rtl":undefined}>«&nbsp;{q.quote}&nbsp;»</blockquote><figcaption>{q.name}</figcaption></figure></li>)}
          </ul>
          <div class="tcar-nav"><button type="button" id="tcar-prev" aria-label="Témoignage précédent">‹</button><button type="button" id="tcar-next" aria-label="Témoignage suivant">›</button></div>
        </div>
        <p id="stock-note" role="status"></p>
        <p id="promo-end" hidden></p>
        <div id="duo-copy" hidden>
          <label class="duo-heading">
            <strong id="duo-title">Offrez-en un, gardez-en un</strong>
            <input id="duo-toggle" type="checkbox" role="switch" aria-labelledby="duo-title" aria-controls="duo-colors" aria-describedby="duo-price" />
            <span id="duo-price"></span>
          </label>
          <fieldset id="duo-colors" class="swatches" hidden>
            <legend>{initial.collection === "bladi" ? "Modèle" : "Couleur"} du deuxième sac <strong id="duo-color-name"></strong></legend>
            <div class="swatch-list">
              {P.map(p => <div class="sw" data-out={p.stockStatus === "out_of_stock"}>
                <input type="radio" name="duo-color" id={`duo-${p.id}`} value={p.id} disabled={p.stockStatus === "out_of_stock"} />
                <label for={`duo-${p.id}`}><img src={p.thumb} alt="" width="80" height="80" loading="lazy" /><span>{p.colorLabel}</span></label>
              </div>)}
            </div>
            <p id="duo-error" role="status"></p>
          </fieldset>
        </div>
        <div class="purchase-actions">
          <button type="button" class="btn btn-ghost" id="catalog-add">Ajouter au panier</button>
          <a class="btn btn-primary" id="hero-cta" href="#commander" data-cta="hero" aria-haspopup="dialog" aria-controls="view-checkout">Commander directement</a>
        </div>
        <section class="vcards" aria-labelledby="vcards-h">
          <h3 id="vcards-h">Le sac en mouvement</h3>
          <div class="vcards-list">
            {[["zman-ugc-1", "Sur 2M", "Vidéo : Maison Sabra sur 2M"], ["zman-deballage-rouge", "Déballage", "Vidéo de déballage du coffret Maison Sabra"], ["zman-ugc-3", "Porté", "Vidéo : le sac porté avec des caftans"]].map(([f, t, a]) => (
              <figure class="vcard">
                <div class="vcard-frame">
                  <video src={`/zmancollection/lp/assets/videos/${f}.mp4`} poster={`/zmancollection/lp/assets/videos/${f}.jpg`} preload="none" playsinline loop width="540" height="960" aria-label={a}></video>
                  <button class="vcard-play" type="button" aria-label={`Lire : ${t}`} aria-pressed="false"><span aria-hidden="true"></span></button>
                </div>
                <figcaption>{t}</figcaption>
              </figure>
            ))}
          </div>
        </section>
        <aside class="pillars" aria-label="Garantie Maison Sabra">
        {[[ShieldCheck,"Payez après inspection","Ouvrez, vérifiez, puis payez. Zéro risque."],[Truck,"Livraison gratuite","Partout au Maroc, expédiée sous 48h."],[RefreshCcw,"Retour & échange sous 3 jours","Un souci ? Nous trouvons une solution simple."],[MessageCircle,"Conciergerie WhatsApp 7j/7","Une question avant de commander ? Une vraie personne vous répond."]].map(([icon,title,body])=><div class="pillar"><span class="pillar-icon" aria-hidden="true" set:html={icon}></span><strong>{title}</strong><p>{body}</p></div>)}</aside>
      </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>(".vcard").forEach((card) => {
    const v = card.querySelector("video")!, b = card.querySelector("button")!;
    const sync = () => { const on = !v.paused; card.classList.toggle("is-playing", on); b.setAttribute("aria-pressed", String(on)); };
    const toggle = () => {
      if (v.paused) {
        document.querySelectorAll<HTMLVideoElement>(".vcard video").forEach((o) => { if (o !== v) o.pause(); });
        v.play().catch(() => {});
      } else v.pause();
    };
    b.addEventListener("click", toggle);
    v.addEventListener("click", toggle);
    v.addEventListener("play", sync); v.addEventListener("pause", sync);
  });
</script>
