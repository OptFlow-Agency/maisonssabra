---
// Fiche technique du modèle sélectionné (CRM : onglet « Details & craft », lignes « Extra » comprises).
// Mise à jour au changement de coloris par app.js ; masquée quand le CRM n'a aucun détail pour ce modèle.
import { specsHtml } from "../lib/details.js";
const { initial } = Astro.props;
const specs = specsHtml(initial);
---
<section class="details" id="details" aria-labelledby="h-details" hidden={!specs}>
  <h2 id="h-details">Tout ce qu’il faut savoir, sans surprise.</h2>
  <p class="muted">Informations du modèle sélectionné : <strong id="d-model">{initial.name}</strong></p>
  <dl class="specs" id="specs" set:html={specs} />
</section>
